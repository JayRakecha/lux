            { id: 7, name: 'High Gloss Ceramic Cabinet', cat: 'cabinets', price: 54999, oldPrice: 74999, rating: 4, reviews: 67, badge: 'sale', material: 'Teak Wood', desc: 'Premium high-gloss ceramic finish cabinet with brass handles.', img: 'https://images.unsplash.com/photo-1631048498692-af6262577031?w=600' },
            { id: 8, name: 'Nordic Coffee Table', cat: 'cabinets', price: 24999, oldPrice: 34999, rating: 4, reviews: 118, badge: 'new', material: 'Oak Wood', desc: 'Minimalist Scandinavian design with solid oak legs and glass top.', img: 'https://images.unsplash.com/photo-1567016432779-094069958ea5?w=500&q=80' },
            { id: 9, name: 'Rattan Accent Chair', cat: 'chairs', price: 18999, oldPrice: 27999, rating: 4, reviews: 84, badge: 'hot', material: 'Rattan', desc: 'Boho-chic rattan accent chair with plush cushioned seat.', img: 'https://images.unsplash.com/photo-1567538096621-38d2284b23ff?w=500&q=80' },
            { id: 10, name: 'Platform Storage Bed', cat: 'beds', price: 79999, oldPrice: 109999, rating: 5, reviews: 201, badge: 'bestseller', material: 'Walnut Wood', desc: 'Low-profile platform bed with integrated storage drawers.', img: 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=500&q=80' },
            { id: 11, name: 'Extendable Dining Set 6-Seat', cat: 'dining', price: 94999, oldPrice: 134999, rating: 4, reviews: 73, badge: 'sale', material: 'Solid Wood', desc: 'Elegant extendable table that converts from 4 to 8 seating with ease.', img: 'https://images.unsplash.com/photo-1615876234886-fd9a39fda97f?w=500&q=80' },
            { id: 12, name: 'Executive Office Desk', cat: 'cabinets', price: 49999, oldPrice: 69999, rating: 5, reviews: 145, badge: 'new', material: 'Wenge Wood', desc: 'Sophisticated executive desk with cable management and leather inlay.', img: 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=500&q=80' },
        ];

        // ============================================================
        // GLOBAL STATE
        // ============================================================
        let cart = JSON.parse(localStorage.getItem('luxecasa_cart') || '[]');
        let wishlist = JSON.parse(localStorage.getItem('luxecasa_wishlist') || '[]');
        let currentView = 'grid';
        let currentSort = 'default';

        // ============================================================
        // WISHLIST RENDER
        // ============================================================
        function getWishlistProducts() {
            let items = productsData.filter(p => wishlist.includes(p.id));
            const sort = document.getElementById('sortSelect')?.value || 'default';
            if (sort === 'price-low') items.sort((a, b) => a.price - b.price);
            else if (sort === 'price-high') items.sort((a, b) => b.price - a.price);
            else if (sort === 'discount') items.sort((a, b) => (b.oldPrice - b.price) - (a.oldPrice - a.price));
            else if (sort === 'rating') items.sort((a, b) => b.rating - a.rating);
            else if (sort === 'name') items.sort((a, b) => a.name.localeCompare(b.name));
            return items;
        }

        function renderWishlist() {
            const items = getWishlistProducts();
            const grid = document.getElementById('wishlistGrid');
            const emptyEl = document.getElementById('wishlistEmpty');
            const layoutEl = document.getElementById('wishlistLayout');
            const actionsBar = document.getElementById('actionsBar');

            // Update count
            document.getElementById('wabCount').textContent = items.length;
            document.getElementById('heroStatCount').textContent = items.length;

            if (items.length === 0) {
                emptyEl.classList.add('show');
                layoutEl.style.display = 'none';
                actionsBar.style.opacity = '0.5';
                actionsBar.style.pointerEvents = 'none';
                updateHeroStats([]);
                return;
            }

            emptyEl.classList.remove('show');
            layoutEl.style.display = 'grid';
            actionsBar.style.opacity = '1';
            actionsBar.style.pointerEvents = 'all';

            const badgeMap = {
                sale: '<span class="badge badge-sale">Sale</span>',
                new: '<span class="badge badge-new">New</span>',
                hot: '<span class="badge badge-hot">🔥 Hot</span>',
                bestseller: '<span class="badge badge-bestseller">Bestseller</span>',
                limited: '<span class="badge badge-limited">💎 Limited</span>'
            };

            grid.innerHTML = items.map((p, i) => {
                const stars = '★'.repeat(p.rating) + '☆'.repeat(5 - p.rating);
                const discount = Math.round((1 - p.price / p.oldPrice) * 100);
                return `
        <div class="product-card" style="animation-delay:${i * 60}ms" onclick="window.location.href='product-detail.html?id=${p.id}'">
            <button class="btn-remove-wishlist" onclick="event.stopPropagation(); removeFromWishlist(${p.id})" title="Remove from Wishlist">
                <i class="fas fa-times"></i>
            </button>
            <div class="product-img-wrap">
                <img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=500&q=60'">
                <div class="product-badges">${badgeMap[p.badge] || ''}</div>
                <div class="product-actions">
                    <button class="action-btn wishlist-active" onclick="event.stopPropagation(); removeFromWishlist(${p.id})" title="Remove from Wishlist"><i class="fas fa-heart"></i></button>
                    <button class="action-btn" onclick="event.stopPropagation(); window.location.href='product-detail.html?id=${p.id}'" title="Quick View"><i class="fas fa-eye"></i></button>
                    <button class="action-btn" onclick="event.stopPropagation(); addToCart(${p.id},'${p.name}',${p.price})" title="Add to Cart"><i class="fas fa-bag-shopping"></i></button>
                </div>
            </div>
            <div class="product-body">
                <div class="date-added"><i class="fas fa-heart"></i> Saved to wishlist</div>
                <p class="product-cat">${p.cat.replace('-', ' ')}</p>
                <h3 class="product-name">${p.name}</h3>
                <p class="product-short-desc">${p.desc}</p>
                <div class="product-meta">
                    <div class="product-rating">
                        <span style="color:var(--gold)">${stars}</span>
                        <span style="font-size:0.75rem;color:var(--text-muted)">(${p.reviews})</span>
                    </div>
                    <span class="product-material">${p.material}</span>
                </div>
                <div class="product-footer">
                    <div class="product-price">
                        <span class="price-main">₹${p.price.toLocaleString('en-IN')}</span>
                        <span class="price-old">₹${p.oldPrice.toLocaleString('en-IN')}</span>
                        <span class="price-off">${discount}% OFF</span>
                    </div>
                    <button class="btn-cart" onclick="event.stopPropagation(); addToCart(${p.id},'${p.name}',${p.price})">
                        <i class="fas fa-bag-shopping"></i> Add
                    </button>
                </div>
            </div>
        </div>`;
            }).join('');

            // Apply view
            grid.className = currentView === 'list' ? 'list-view' : '';

            // Trigger animations
            setTimeout(() => {
                document.querySelectorAll('.product-card').forEach((el, i) => {
                    setTimeout(() => el.classList.add('visible'), i * 60);
                });
            }, 80);

            updateSummary(items);
            updateHeroStats(items);
            renderRecommended(items);
        }

        // ============================================================
        // HERO STATS
        // ============================================================
        function updateHeroStats(items) {
            const totalVal = items.reduce((s, p) => s + p.price, 0);
            const totalOld = items.reduce((s, p) => s + p.oldPrice, 0);
            const savings = totalOld - totalVal;
            const cats = new Set(items.map(p => p.cat)).size;

            document.getElementById('heroStatCount').textContent = items.length;
            document.getElementById('heroStatValue').textContent = '₹' + totalVal.toLocaleString('en-IN');
            document.getElementById('heroStatSavings').textContent = '₹' + savings.toLocaleString('en-IN');
            document.getElementById('heroStatCategories').textContent = cats;
        }

        // ============================================================
        // SIDEBAR SUMMARY
        // ============================================================
        function updateSummary(items) {
            const totalPrice = items.reduce((s, p) => s + p.price, 0);
            const totalOld = items.reduce((s, p) => s + p.oldPrice, 0);
            const savings = totalOld - totalPrice;

            document.getElementById('summaryItems').textContent = items.length + ' item' + (items.length !== 1 ? 's' : '');
            document.getElementById('summaryOriginal').textContent = '₹' + totalOld.toLocaleString('en-IN');
            document.getElementById('summaryDiscounted').textContent = '₹' + totalPrice.toLocaleString('en-IN');
            document.getElementById('summarySavings').textContent = '₹' + savings.toLocaleString('en-IN');
        }

        // ============================================================
        // REMOVE FROM WISHLIST
        // ============================================================
        function removeFromWishlist(id) {
            wishlist = wishlist.filter(wid => wid !== id);
            localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
            showToast('Removed from wishlist');
            renderWishlist();
        }

        // ============================================================
        // CLEAR ALL WISHLIST
        // ============================================================
        function clearAllWishlist() {
            if (wishlist.length === 0) { showToast('⚠ Wishlist is already empty'); return; }
            if (!confirm('Are you sure you want to clear your entire wishlist?')) return;
            wishlist = [];
            localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
            showToast('🗑 Wishlist cleared');
            renderWishlist();
        }

        // ============================================================
        // ADD ALL TO CART
        // ============================================================
        function addAllToCart() {
            const items = getWishlistProducts();
            if (items.length === 0) { showToast('⚠ No items in wishlist'); return; }
            items.forEach(p => addToCart(p.id, p.name, p.price, false));
            showToast(`✓ ${items.length} item${items.length > 1 ? 's' : ''} added to cart!`);
            setTimeout(() => toggleCart(), 600);
        }

        // ============================================================
        // SORT
        // ============================================================
        function sortWishlist() {
            renderWishlist();
        }

        // ============================================================
        // VIEW TOGGLE (Grid / List)
        // ============================================================
        function setView(view) {
            currentView = view;
            const grid = document.getElementById('wishlistGrid');
            const gridBtn = document.getElementById('gridViewBtn');
            const listBtn = document.getElementById('listViewBtn');
            if (view === 'list') {
                grid.className = 'list-view';
                listBtn.classList.add('active');
                gridBtn.classList.remove('active');
            } else {
                grid.className = '';
                gridBtn.classList.add('active');
                listBtn.classList.remove('active');
            }
        }

        // ============================================================
        // RECOMMENDED PRODUCTS
        // ============================================================
        function renderRecommended(wishlistItems) {
            const wishlistIds = wishlistItems.map(p => p.id);
            const recProducts = productsData.filter(p => !wishlistIds.includes(p.id)).slice(0, 4);
            const recGrid = document.getElementById('recGrid');
            const section = document.getElementById('recommendSection');

            if (recProducts.length === 0) { section.style.display = 'none'; return; }
            section.style.display = 'block';

            const badgeMap = {
                sale: '<span class="badge badge-sale">Sale</span>',
                new: '<span class="badge badge-new">New</span>',
                hot: '<span class="badge badge-hot">🔥 Hot</span>',
                bestseller: '<span class="badge badge-bestseller">Bestseller</span>'
            };

            recGrid.innerHTML = recProducts.map((p, i) => {
                const stars = '★'.repeat(p.rating) + '☆'.repeat(5 - p.rating);
                const discount = Math.round((1 - p.price / p.oldPrice) * 100);
                const isInWishlist = wishlist.includes(p.id);
                return `
        <div class="product-card reveal" style="animation-delay:${i * 80}ms" onclick="window.location.href='product-detail.html?id=${p.id}'">
            <div class="product-img-wrap">
                <img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=500&q=60'">
                <div class="product-badges">${badgeMap[p.badge] || ''}</div>
                <div class="product-actions">
                    <button class="action-btn ${isInWishlist ? 'wishlist-active' : ''}" onclick="event.stopPropagation(); toggleWishlistBtn(${p.id}, this)" title="Wishlist"><i class="fas fa-heart"></i></button>
                    <button class="action-btn" onclick="event.stopPropagation(); window.location.href='product-detail.html?id=${p.id}'" title="Quick View"><i class="fas fa-eye"></i></button>
                    <button class="action-btn" onclick="event.stopPropagation(); addToCart(${p.id},'${p.name}',${p.price})" title="Add to Cart"><i class="fas fa-bag-shopping"></i></button>
                </div>
            </div>
            <div class="product-body">
                <p class="product-cat">${p.cat.replace('-', ' ')}</p>
                <h3 class="product-name">${p.name}</h3>
                <p class="product-short-desc">${p.desc}</p>
                <div class="product-meta">
                    <div class="product-rating">
                        <span style="color:var(--gold)">${stars}</span>
                        <span style="font-size:0.75rem;color:var(--text-muted)">(${p.reviews})</span>
                    </div>
                    <span class="product-material">${p.material}</span>
                </div>
                <div class="product-footer">
                    <div class="product-price">
                        <span class="price-main">₹${p.price.toLocaleString('en-IN')}</span>
                        <span class="price-old">₹${p.oldPrice.toLocaleString('en-IN')}</span>
                        <span class="price-off">${discount}% OFF</span>
                    </div>
                    <button class="btn-cart" onclick="event.stopPropagation(); addToCart(${p.id},'${p.name}',${p.price})">
                        <i class="fas fa-bag-shopping"></i> Add
                    </button>
                </div>
            </div>
        </div>`;
            }).join('');

            // Trigger reveal for recommended cards
            setTimeout(() => {
                recGrid.querySelectorAll('.product-card.reveal').forEach((el, i) => {
                    setTimeout(() => el.classList.add('visible'), i * 80);
                });
            }, 100);
        }

        // ============================================================
        // WISHLIST TOGGLE (for recommended section)
        // ============================================================
        function toggleWishlistBtn(id, btn) {
            const idx = wishlist.indexOf(id);
            if (idx === -1) {
                wishlist.push(id);
                btn.classList.add('wishlist-active');
                showToast('❤ Added to wishlist');
            } else {
                wishlist.splice(idx, 1);
                btn.classList.remove('wishlist-active');
                showToast('Removed from wishlist');
            }
            localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
            renderWishlist();
        }

        // ============================================================
        // CART SYSTEM
        // ============================================================
        function addToCart(id, name, price, doToast = true) {
            const existing = cart.find(item => item.id === id);
            if (existing) { existing.qty++; }
            else { cart.push({ id, name, price, qty: 1, img: productsData.find(p => p.id === id)?.img || '' }); }
            saveCart();
            updateCartUI();
            if (doToast) showToast(`✓ ${name} added to cart!`);
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            saveCart();
            updateCartUI();
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) removeFromCart(id);
                else { saveCart(); updateCartUI(); }
            }
        }

        function saveCart() {
            localStorage.setItem('luxecasa_cart', JSON.stringify(cart));
        }

        function updateCartUI() {
            const total = cart.reduce((sum, i) => sum + i.qty, 0);
            const subtotal = cart.reduce((sum, i) => sum + i.price * i.qty, 0);
            const gst = Math.round(subtotal * 0.18);
            const grandTotal = subtotal + gst;

            document.getElementById('cartBadge').textContent = total;
            document.getElementById('cartCount').textContent = `(${total} item${total !== 1 ? 's' : ''})`;

            const listEl = document.getElementById('cartItemsList');
            const footerEl = document.getElementById('cartFooter');

            if (cart.length === 0) {
                listEl.innerHTML = `<div style="text-align:center;padding:60px 20px;color:var(--text-muted)">
            <i class="fas fa-shopping-bag" style="font-size:3rem;color:var(--cream2);margin-bottom:15px;display:block"></i>
            <p>Your cart is empty</p>
            <a href="products" style="color:var(--gold);font-size:0.85rem">Start Shopping →</a>
        </div>`;
                footerEl.style.display = 'none';
            } else {
                listEl.innerHTML = cart.map(item => `
        <div class="cart-item">
            <div class="cart-item-img">
                <img src="${item.img}" alt="${item.name}" onerror="this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=80&q=60'">
            </div>
            <div class="cart-item-info">
                <h4 class="cart-item-name">${item.name}</h4>
                <p class="cart-item-price">₹${item.price.toLocaleString('en-IN')}</p>
                <div class="cart-item-qty">
                    <button class="qty-btn" onclick="changeQty(${item.id}, -1)">−</button>
                    <span class="qty-num">${item.qty}</span>
                    <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
                </div>
                <button class="cart-item-remove" onclick="removeFromCart(${item.id})">Remove</button>
            </div>
        </div>`).join('');

                document.getElementById('cartSubtotal').textContent = `₹${subtotal.toLocaleString('en-IN')}`;
                document.getElementById('cartGST').textContent = `₹${gst.toLocaleString('en-IN')}`;
                document.getElementById('cartTotal').textContent = `₹${grandTotal.toLocaleString('en-IN')}`;
                footerEl.style.display = 'block';
            }
        }

        function toggleCart() {
            document.getElementById('cartSidebar').classList.toggle('open');
            document.getElementById('cartOverlay').classList.toggle('show');
        }

        // ============================================================
        // SHARE MODAL
        // ============================================================
        function openShareModal() {
            if (wishlist.length === 0) { showToast('⚠ Add items to wishlist first'); return; }
            document.getElementById('shareModal').classList.add('show');
        }

        function closeShareModal(e) {
            if (e.target === document.getElementById('shareModal')) {
                document.getElementById('shareModal').classList.remove('show');
            }
        }

        function copyShareLink() {
            const input = document.getElementById('shareLink');
            input.select();
            document.execCommand('copy');
            showToast('🔗 Link copied to clipboard!');
        }

        // ============================================================
        // NAVBAR
        // ============================================================
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            const backTop = document.getElementById('backTop');
            if (window.scrollY > 80) { nav.classList.add('scrolled'); backTop.classList.add('show'); }
            else { nav.classList.remove('scrolled'); backTop.classList.remove('show'); }
        });

        function toggleSearch() {
            const q = prompt('Search for furniture...');
            if (q) window.location.href = `products?search=${encodeURIComponent(q)}`;
        }

        function toggleMobileMenu() {
            const links = document.querySelector('.nav-links');
            if (links.style.display === 'flex') {
                links.style.display = 'none';
            } else {
                links.style.cssText = 'display:flex;flex-direction:column;position:absolute;top:80px;left:0;right:0;background:#fff;padding:20px;box-shadow:0 20px 40px rgba(0,0,0,0.1);z-index:999;gap:15px;';
            }
        }

        // ============================================================
        // NEWSLETTER
        // ============================================================
        function subscribeNewsletter() {
            const email = document.getElementById('newsletterEmail').value.trim();
            if (!email || !/\S+@\S+\.\S+/.test(email)) {
                showToast('⚠ Please enter a valid email address.');
                return;
            }
            showToast('🎉 Subscribed! Check your email for 10% discount code.');
            document.getElementById('newsletterEmail').value = '';
        }

        // ============================================================
        // TOAST
        // ============================================================
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerHTML = msg;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // ============================================================
        // REVEAL ANIMATION
        // ============================================================
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('visible');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

        // ============================================================
        // SESSION CHECK
        // ============================================================
        function checkSession() {
            const user = JSON.parse(localStorage.getItem('luxecasa_user') || 'null');
            const btn = document.getElementById('navLoginBtn');
            if (user && btn) {
                btn.innerHTML = `<i class="fas fa-user-circle"></i> ${user.full_name?.split(' ')[0] || 'Account'}`;
                btn.href = 'profile.html';
            }
        }

        // ============================================================
        // DEMO: Pre-load some wishlist items if empty (for showcase)
        // ============================================================
        function loadDemoWishlist() {
            // Only pre-load if wishlist is completely empty AND user hasn't visited before
            if (wishlist.length === 0 && !localStorage.getItem('luxecasa_wishlist_visited')) {
                wishlist = [1, 2, 4, 6]; // Pre-selected demo items
                localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
                localStorage.setItem('luxecasa_wishlist_visited', '1');
            }
        }

        // ============================================================
        // INIT
        // ============================================================
        loadDemoWishlist();
        renderWishlist();
        updateCartUI();
        checkSession();
    </script>
</body>

</html>