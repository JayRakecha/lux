                <a href="terms.html" style="color:rgba(245,240,232,0.3);font-size:0.8rem;text-decoration:none">Terms of
                    Service</a>
                <a href="refund.html"
                    style="color:var(--gold);font-size:0.8rem;text-decoration:none;font-weight:600">Refund Policy</a>
            </div>
            <div class="footer-payment">
                <span class="payment-icon">VISA</span>
                <span class="payment-icon">MASTERCARD</span>
                <span class="payment-icon">UPI</span>
                <span class="payment-icon">RAZORPAY</span>
                <span class="payment-icon">COD</span>
            </div>
        </div>
    </footer>

    <!-- ===== BACK TO TOP ===== -->
    <button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i
            class="fas fa-arrow-up"></i></button>

    <!-- ===== CART SIDEBAR ===== -->
    <div class="cart-overlay" id="cartOverlay" onclick="toggleCart()"></div>
    <div class="cart-sidebar" id="cartSidebar">
        <div class="cart-header">
            <h3>Your Cart <span style="font-size:0.85rem;color:var(--text-muted)" id="cartCount">(0 items)</span></h3>
            <button class="cart-close-btn" onclick="toggleCart()"><i class="fas fa-times"></i></button>
        </div>
        <div class="cart-items-list" id="cartItemsList">
            <div style="text-align:center;padding:60px 20px;color:var(--text-muted)">
                <i class="fas fa-shopping-bag"
                    style="font-size:3rem;color:var(--cream2);margin-bottom:15px;display:block"></i>
                <p>Your cart is empty</p>
                <a href="products" style="color:var(--gold);font-size:0.85rem">Start Shopping →</a>
            </div>
        </div>
        <div class="cart-footer" id="cartFooter" style="display:none">
            <div class="cart-row"><span>Subtotal</span><span id="cartSubtotal">₹0</span></div>
            <div class="cart-row"><span>Delivery</span><span style="color:#52C07A">FREE</span></div>
            <div class="cart-row"><span>GST (18%)</span><span id="cartGST">₹0</span></div>
            <div class="cart-total-row"><span>Total</span><span id="cartTotal" style="color:var(--gold)">₹0</span></div>
            <a href="checkout.html" class="btn-checkout">Proceed to Checkout <i class="fas fa-arrow-right"></i></a>
            <button class="btn-continue-shop" onclick="toggleCart()">Continue Shopping</button>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <!-- ===== JAVASCRIPT ===== -->
    <script>
        // ============================================================
        // READING PROGRESS BAR
        // ============================================================
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = Math.round((scrollTop / docH) * 100);
            document.getElementById('progressBar').style.width = pct + '%';
            const pctEl = document.getElementById('progressPct');
            pctEl.textContent = pct + '% READ';
            pct > 5 ? pctEl.classList.add('show') : pctEl.classList.remove('show');

            document.getElementById('mainNav').classList.toggle('scrolled', scrollTop > 80);
            document.getElementById('backTop').classList.toggle('show', scrollTop > 80);
        });

        // ============================================================
        // ELIGIBILITY CHECKER
        // ============================================================
        const eligibilityData = {
            new: {
                type: 'yes',
                icon: '✅',
                title: 'Great news — Your item is eligible for a full refund or exchange!',
                desc: 'Unused and sealed products qualify under our 30-Day Return Policy. Contact our team at returns@luxecasa.com or +91 98765 43210 to initiate your return. Free pickup will be arranged within 3–5 business days.'
            },
            damaged: {
                type: 'yes',
                icon: '✅',
                title: 'You\'re covered — Damaged arrivals qualify for a full refund or replacement!',
                desc: 'Report the damage within 48 hours of delivery with photographs. Email returns@luxecasa.com immediately. We\'ll arrange a free pickup and send a replacement or issue a full refund within 7–10 business days.'
            },
            wrong: {
                type: 'yes',
                icon: '✅',
                title: 'Absolutely eligible — Wrong items are fully covered!',
                desc: 'If we sent you the wrong product, we will fix it at no cost. Contact us with your order ID and photographs of what you received. We\'ll collect the wrong item and dispatch the correct one with priority.'
            },
            used: {
                type: 'no',
                icon: '❌',
                title: 'Unfortunately, assembled or used items are not eligible for return.',
                desc: 'Once a product has been assembled or used, it cannot be returned under our standard policy. However, if there is a manufacturing defect or structural failure, you may still be covered under our 5-Year Warranty. Contact warranty@luxecasa.com for assessment.'
            }
        };

        function checkEligibility(type, cardEl) {
            document.querySelectorAll('.checker-card').forEach(c => {
                c.classList.remove('selected-yes', 'selected-no');
            });
            const data = eligibilityData[type];
            cardEl.classList.add(data.type === 'yes' ? 'selected-yes' : 'selected-no');
            const resultEl = document.getElementById('checkerResult');
            document.getElementById('resultIcon').textContent = data.icon;
            document.getElementById('resultTitle').textContent = data.title;
            document.getElementById('resultDesc').textContent = data.desc;
            resultEl.className = 'checker-result show result-' + data.type;
            showToast(data.type === 'yes' ? '✅ Your item qualifies for return!' : '❌ This item is not eligible for standard return');
        }

        // ============================================================
        // ACCORDION SECTIONS
        // ============================================================
        function toggleSec(id) {
            const section = document.getElementById(id);
            const isOpen = section.classList.contains('open');
            document.querySelectorAll('.refund-section.open').forEach(s => s.classList.remove('open'));
            document.querySelectorAll('.toc-lnk').forEach(a => a.classList.remove('active'));
            if (!isOpen) {
                section.classList.add('open');
                const lnk = document.querySelector(`.toc-lnk[data-sec="${id}"]`);
                if (lnk) lnk.classList.add('active');
            }
        }

        document.querySelectorAll('.toc-lnk').forEach(link => {
            link.addEventListener('click', e => {
                e.preventDefault();
                const id = link.dataset.sec;
                toggleSec(id);
                document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        // Open first section by default
        toggleSec('sec-overview');

        // ============================================================
        // MARK AS READ
        // ============================================================
        let readCount = 0;
        const TOTAL_SECS = 10;

        function markRead(secId, rowEl) {
            if (rowEl.classList.contains('checked')) return;
            rowEl.classList.add('checked');
            readCount++;
            const lnk = document.querySelector(`.toc-lnk[data-sec="${secId}"]`);
            if (lnk) lnk.classList.add('done');
            document.getElementById('tocReadCount').textContent = readCount + ' / ' + TOTAL_SECS;
            showToast('✅ Section understood (' + readCount + '/' + TOTAL_SECS + ')');
            if (readCount === TOTAL_SECS) {
                setTimeout(() => {
                    const w = document.getElementById('completionWidget');
                    w.classList.add('show');
                    w.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 400);
            }
        }

        // ============================================================
        // REFUND CALCULATOR
        // ============================================================
        /*function calculateRefund() {
            const amount = parseFloat(document.getElementById('calcAmount').value);
            const dateVal = document.getElementById('calcDate').value;
            const payment = document.getElementById('calcPayment').value;
            const reason = document.getElementById('calcReason').value;

            if (!amount || amount <= 0) { showToast('⚠ Please enter a valid order amount'); return; }
            if (!dateVal) { showToast('⚠ Please enter your delivery date'); return; }

            const deliveryDate = new Date(dateVal);
            const today = new Date();
            const deadlineDate = new Date(deliveryDate);
            deadlineDate.setDate(deadlineDate.getDate() + 30);

            const daysLeft = Math.ceil((deadlineDate - today) / (1000 * 60 * 60 * 24));
            const deadlineStr = deadlineDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

            let refundAmount = 0;
            let note = '';

            if (reason === 'custom') {
                refundAmount = 0;
                note = '⚠ Custom/bespoke orders are non-refundable once manufacturing has commenced. You may be eligible for a replacement if there is a manufacturing defect.';
            } else if (daysLeft < 0) {
                refundAmount = 0;
                note = '⚠ Your 30-day return window has expired. However, if there is a manufacturing defect, you may still be covered under the 5-Year Warranty.';
            } else {
                refundAmount = amount;
                const paymentTimeline = { card: '3–5 banking days', upi: '2–4 banking days', netbanking: '5–7 banking days', cod: '10–12 business days (bank transfer)', emi: '5–7 banking days (check with your bank)' };
                note = `✓ Full refund eligible. Processing time after inspection: ${paymentTimeline[payment] || '5–7 business days'}. ${daysLeft > 0 ? daysLeft + ' days remaining in your return window.' : 'Your return window ends today.'}`;
            }

            document.getElementById('calcRefundAmt').textContent = refundAmount > 0 ? '₹' + refundAmount.toLocaleString('en-IN') : '₹0';
            document.getElementById('calcDeadline').textContent = daysLeft >= 0 ? deadlineStr : 'Expired';
            document.getElementById('calcDaysLeft').textContent = daysLeft > 0 ? daysLeft + ' days' : (daysLeft === 0 ? 'Today!' : 'Expired');
