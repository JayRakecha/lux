                <p>Select your situation to instantly find out if your item qualifies for a return or refund</p>
            </div>
            <div class="checker-grid" id="checkerGrid">
                <div class="checker-card" onclick="checkEligibility('new', this)">
                    <span class="checker-card-icon">📦</span>
                    <h3>Unused & Sealed</h3>
                    <p>Product is unused, unassembled, and in original packaging with all accessories intact</p>
                </div>
                <div class="checker-card" onclick="checkEligibility('damaged', this)">
                    <span class="checker-card-icon">🔨</span>
                    <h3>Arrived Damaged</h3>
                    <p>Product arrived broken, cracked or with visible damage at the time of delivery</p>
                </div>
                <div class="checker-card" onclick="checkEligibility('wrong', this)">
                    <span class="checker-card-icon">🔄</span>
                    <h3>Wrong Item Received</h3>
                    <p>Received a different product than what was ordered — wrong colour, size or model</p>
                </div>
                <div class="checker-card" onclick="checkEligibility('used', this)">
                    <span class="checker-card-icon">🛋️</span>
                    <h3>Already Assembled / Used</h3>
                    <p>Product has been assembled, used, modified or shows signs of wear</p>
                </div>
            </div>
            <div class="checker-result" id="checkerResult">
