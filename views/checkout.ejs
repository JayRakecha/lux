<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeCasa – Secure Checkout | Premium Furniture</title>
    <meta name="description"
        content="Complete your LuxeCasa order securely. Premium furniture delivered to your doorstep.">
    <link rel="stylesheet" href="css/fonts.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/<%= pageCss %>">
</head>

<body>

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="top-bar-scroll">
            🔒 <span class="gold">100% Secure Checkout</span> &nbsp;|&nbsp; Free Delivery above ₹10,000 &nbsp;|&nbsp; 🌟
            Premium Quality Guaranteed &nbsp;|&nbsp; Easy Returns within 30 Days &nbsp;|&nbsp; 🏠 White Glove
            Installation Available &nbsp;|&nbsp; EMI Available on All Major Credit Cards
        </div>
    </div>

    <!-- NAVBAR -->
    <nav id="mainNav">
        <a href="index.html" class="nav-logo">
            <div class="logo-icon">🛋</div>
            <h1>Luxe<span>Casa</span></h1>
        </a>
        <div class="nav-right">
            <a href="products" class="nav-back-link"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
            <div class="nav-secure">
                <i class="fas fa-shield-halved"></i>
                <span>SSL Secured</span>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <div class="checkout-hero">
        <div class="hero-inner">
            <div class="breadcrumb">
                <a href="index.html">Home</a>
                <i class="fas fa-chevron-right"></i>
                <a href="products">Products</a>
                <i class="fas fa-chevron-right"></i>
                <span class="bc-current">Secure Checkout</span>
            </div>
            <h1>Secure <em>Checkout</em></h1>
            <p>Complete your order — premium furniture delivered to your doorstep</p>
        </div>
    </div>

    <!-- STEP BAR -->
    <div class="steps-bar">
        <div class="steps-inner">
            <div class="step-item active" id="si-1">
                <div class="step-num" id="sn-1">1</div>
                <div class="step-label">Delivery</div>
            </div>
            <div class="step-item" id="si-2">
                <div class="step-num" id="sn-2">2</div>
                <div class="step-label">Payment</div>
            </div>
            <div class="step-item" id="si-3">
                <div class="step-num" id="sn-3">3</div>
                <div class="step-label">Review</div>
            </div>
            <div class="step-item" id="si-4">
                <div class="step-num" id="sn-4">4</div>
                <div class="step-label">Confirm</div>
            </div>
        </div>
    </div>

    <!-- MAIN -->
    <div class="checkout-main">

        <!-- ======================================================
         LEFT COLUMN
    ====================================================== -->
        <div>

            <!-- ========== STEP 1: DELIVERY ========== -->
            <div class="checkout-panel checkout-step active" id="step-1">
                <div class="panel-header">
                    <div class="panel-icon"><i class="fas fa-location-dot"></i></div>
                    <div>
                        <h2>Delivery Address</h2>
                        <p>Where should we deliver your luxury furniture?</p>
                    </div>
                    <div class="panel-badge">Step 1 of 3</div>
                </div>
                <div class="panel-body">
                    <div class="section-label">Enter Delivery Address</div>

                    <div id="newAddrForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label>First Name<span class="req">*</span></label>
                                <input type="text" class="form-control" id="fName" placeholder="Rahul">
                                <div class="form-error" id="fNameErr">Please enter your first name</div>
                            </div>
                            <div class="form-group">
                                <label>Last Name<span class="req">*</span></label>
                                <input type="text" class="form-control" id="lName" placeholder="Sharma">
                                <div class="form-error" id="lNameErr">Please enter your last name</div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Mobile Number<span class="req">*</span></label>
                                <input type="tel" class="form-control" id="phone" placeholder="+91 98765 43210"
                                    maxlength="13">
                                <div class="form-error" id="phoneErr">Enter a valid 10-digit number</div>
                            </div>
                            <div class="form-group">
                                <label>Email Address<span class="req">*</span></label>
                                <input type="email" class="form-control" id="email" placeholder="rahul@example.com">
                                <div class="form-error" id="emailErr">Enter a valid email address</div>
                            </div>
                        </div>
                        <div class="form-row full">
                            <div class="form-group">
                                <label>Address Line 1<span class="req">*</span></label>
                                <input type="text" class="form-control" id="addr1"
                                    placeholder="House No., Building Name, Street">
                                <div class="form-error" id="addr1Err">Please enter your address</div>
                            </div>
                        </div>
                        <div class="form-row full">
                            <div class="form-group">
                                <label>Address Line 2 <span
                                        style="color:var(--text-muted);font-weight:400;">(Optional)</span></label>
                                <input type="text" class="form-control" id="addr2" placeholder="Area, Colony, Landmark">
                            </div>
                        </div>
                        <div class="form-row triple">
                            <div class="form-group">
                                <label>City<span class="req">*</span></label>
                                <input type="text" class="form-control" id="city" placeholder="New Delhi">
                                <div class="form-error" id="cityErr">Please enter your city</div>
                            </div>
                            <div class="form-group">
                                <label>State<span class="req">*</span></label>
                                <select class="form-control" id="state">
                                    <option value="">Select State</option>
                                    <option>Andhra Pradesh</option>
                                    <option>Assam</option>
                                    <option>Bihar</option>
                                    <option>Delhi</option>
                                    <option>Goa</option>
                                    <option>Gujarat</option>
                                    <option>Haryana</option>
                                    <option>Himachal Pradesh</option>
                                    <option>Jharkhand</option>
                                    <option>Karnataka</option>
                                    <option>Kerala</option>
                                    <option>Madhya Pradesh</option>
                                    <option>Maharashtra</option>
                                    <option>Odisha</option>
                                    <option>Punjab</option>
                                    <option>Rajasthan</option>
                                    <option>Tamil Nadu</option>
                                    <option>Telangana</option>
                                    <option>Uttar Pradesh</option>
                                    <option>Uttarakhand</option>
                                    <option>West Bengal</option>
                                </select>
                                <div class="form-error" id="stateErr">Please select your state</div>
                            </div>
                            <div class="form-group">
                                <label>PIN Code<span class="req">*</span></label>
                                <input type="text" class="form-control" id="pincode" placeholder="110016" maxlength="6">
                                <div class="form-error" id="pincodeErr">Enter a valid 6-digit PIN</div>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery type -->
                    <div style="margin-top:28px;">
                        <div class="section-label">Delivery Type</div>
                        <div class="delivery-options">
                            <div class="delivery-opt selected" onclick="pickDelivery(this,'standard',0)">
                                <div class="d-radio"></div>
                                <div class="d-info">
                                    <div class="d-name">Standard Delivery <span class="chip chip-green">Free</span>
                                    </div>
                                    <div class="d-desc">5–7 Business Days · Free Assembly Included</div>
                                </div>
                                <div class="d-price free">FREE</div>
                            </div>
                            <div class="delivery-opt" onclick="pickDelivery(this,'express',499)">
                                <div class="d-radio"></div>
                                <div class="d-info">
                                    <div class="d-name">Express Delivery <span class="chip chip-gold">Premium</span>
                                    </div>
                                    <div class="d-desc">2–3 Business Days · Priority Scheduling</div>
                                </div>
                                <div class="d-price">₹499</div>
                            </div>
                            <div class="delivery-opt" onclick="pickDelivery(this,'white',999)">
                                <div class="d-radio"></div>
                                <div class="d-info">
                                    <div class="d-name">White Glove Service <span class="chip chip-gold">Luxury</span>
                                    </div>
                                    <div class="d-desc">Next Day · Premium Install + Room Placement + Packaging Disposal
                                    </div>
                                </div>
                                <div class="d-price">₹999</div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="panel-nav">
                    <a href="products" class="btn-back"><i class="fas fa-arrow-left"></i> Back to Cart</a>
                    <button class="btn-next" onclick="toStep(2)">Continue to Payment <i
                            class="fas fa-arrow-right"></i></button>
                </div>
            </div><!-- end step-1 -->

            <!-- ========== STEP 2: PAYMENT ========== -->
            <div class="checkout-panel checkout-step" id="step-2">
                <div class="panel-header">
                    <div class="panel-icon"><i class="fas fa-credit-card"></i></div>
                    <div>
                        <h2>Payment Method</h2>
                        <p>All transactions are 256-bit SSL encrypted</p>
                    </div>
                    <div class="panel-badge">Step 2 of 3</div>
                </div>
                <div class="panel-body">
                    <div class="pay-form show" id="pf-cod">
                        <div class="cod-block">
                            <div class="cod-icon"><i class="fas fa-hand-holding-dollar"></i></div>
                            <h3>Cash on Delivery</h3>
                            <p>Pay with cash or UPI at the time of delivery.<br>Our executive will assist you during
                                handover.</p>
                            <div class="cod-charge-note">
                                <i class="fas fa-triangle-exclamation"></i>
                                A COD handling charge of <strong style="margin-left:4px;">₹99</strong> will be added to
                                your order total.
                            </div>
                        </div>
                    </div>

                    <div class="security-strip">
                        <i class="fas fa-lock"></i>
                        <div>
                            <strong>🔒 100% Secure Transaction</strong>
                            Your order details are protected by 256-bit SSL encryption.
                        </div>
                    </div>
                </div>
                <!--<div class="panel-body">

                    <div class="pay-tabs">
