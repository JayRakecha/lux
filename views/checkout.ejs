                    onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\\'r-img-fallback\\'>${emoji}</div>';"
                >
            </div>
            <div style="flex:1;min-width:0;">
                <div class="r-name">${item.name}</div>
                <div class="r-meta">Qty: ${item.qty} · In Stock</div>
            </div>
            <div class="r-price">₹${lineTotal}</div>
        </div>`;
            }).join('');
        }

        // ============================================================
        // CALC TOTAL
        // ============================================================
        function calcTotal() {
            const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
            const origTotal = cart.reduce((s, i) => s + (i.originalPrice || i.price) * i.qty, 0);
            const prodDisc = origTotal - subtotal;
            const codExtra = (payMethod === 'cod') ? 99 : 0;
            const totalDel = deliveryCharge + codExtra;
            const afterCoupon = subtotal - couponSaving;
            const gst = Math.round(afterCoupon * 0.18);
            const grandTotal = afterCoupon + gst + totalDel;
            const totalSaving = prodDisc + couponSaving;

            document.getElementById('pSubtotal').textContent = `₹${origTotal.toLocaleString('en-IN')}`;
            document.getElementById('pDiscount').textContent = `−₹${prodDisc.toLocaleString('en-IN')}`;
            document.getElementById('pGst').textContent = `₹${gst.toLocaleString('en-IN')}`;
            document.getElementById('pTotal').textContent = `₹${grandTotal.toLocaleString('en-IN')}`;

            const shipEl = document.getElementById('pShipping');
            const shipRow = document.getElementById('pShippingRow');
            if (totalDel === 0) {
                shipEl.textContent = 'FREE';
                shipEl.style.color = 'var(--success)';
                shipRow.classList.add('green');
            } else {
                const label = codExtra > 0
                    ? `₹${totalDel.toLocaleString('en-IN')} (incl. COD)`
                    : `₹${totalDel.toLocaleString('en-IN')}`;
                shipEl.textContent = label;
                shipEl.style.color = codExtra ? 'var(--warning)' : 'var(--text)';
                shipRow.classList.remove('green');
            }

            if (totalSaving > 0) {
                document.getElementById('savingsBanner').style.display = 'flex';
                document.getElementById('savingsAmt').textContent = `₹${totalSaving.toLocaleString('en-IN')}`;
            } else {
                document.getElementById('savingsBanner').style.display = 'none';
            }
        }

        // ============================================================
        // BUILD EMI OPTIONS
        // ============================================================
        function buildEmiOptions() {
            const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
            const plans = [
                { m: 3, r: 0, label: '0% Interest — No Cost EMI', bank: 'HDFC / ICICI / SBI' },
                { m: 6, r: 12, label: '12% p.a.', bank: 'All Major Banks' },
                { m: 12, r: 14, label: '14% p.a.', bank: 'All Major Banks' },
                { m: 24, r: 16, label: '16% p.a.', bank: 'All Major Banks' },
            ];
            const el = document.getElementById('emiList');
            if (!el) return;
            el.innerHTML = plans.map((p, i) => {
                let emi;
                if (p.r === 0) {
                    emi = subtotal / p.m;
                } else {
                    const mr = p.r / 1200;
                    emi = subtotal * mr * Math.pow(1 + mr, p.m) / (Math.pow(1 + mr, p.m) - 1);
                }
                const freeTag = p.r === 0 ? '<span class="chip chip-green" style="font-size:0.6rem;">0% EMI</span>' : '';
                return `
        <div class="emi-opt ${i === 0 ? 'selected' : ''}" onclick="pickEmi(this,${p.m})">
            <div>
                <div class="emi-label">${p.m} Months ${freeTag}</div>
                <div class="emi-sub">${p.label} · ${p.bank}</div>
            </div>
            <div class="emi-amount">₹${Math.ceil(emi).toLocaleString('en-IN')}/mo</div>
        </div>`;
            }).join('');
        }

        // ============================================================
        // STEP NAVIGATION
        // ============================================================
        function toStep(n) {
            if (n === 2 && !validateDelivery()) return;
            if (n === 3) fillReview();

            document.querySelectorAll('.checkout-step').forEach(s => s.classList.remove('active'));
            document.getElementById(`step-${n}`).classList.add('active');

            // Update step indicators
            for (let i = 1; i <= 4; i++) {
                const si = document.getElementById(`si-${i}`);
                const sn = document.getElementById(`sn-${i}`);
                si.classList.remove('active', 'done');
                if (i < n) { si.classList.add('done'); sn.innerHTML = '<i class="fas fa-check" style="font-size:0.7rem;"></i>'; }
                if (i === n) { si.classList.add('active'); sn.innerHTML = i; }
                if (i > n) { sn.innerHTML = i; }
            }

            // Hide summary card on success
            if (n === 4) document.getElementById('summaryCard').style.display = 'none';

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

