        function validateDelivery() {
            const fields = [
                { id: 'fName', err: 'fNameErr', ok: v => v.trim().length > 0 },
                { id: 'lName', err: 'lNameErr', ok: v => v.trim().length > 0 },
                { id: 'phone', err: 'phoneErr', ok: v => /^[+\d\s]{10,}$/.test(v.trim()) },
                { id: 'email', err: 'emailErr', ok: v => /\S+@\S+\.\S+/.test(v) },
                { id: 'addr1', err: 'addr1Err', ok: v => v.trim().length > 5 },
                { id: 'city', err: 'cityErr', ok: v => v.trim().length > 0 },
                { id: 'state', err: 'stateErr', ok: v => v !== '' },
                { id: 'pincode', err: 'pincodeErr', ok: v => /^\d{6}$/.test(v) },
            ];
            let ok = true;
            fields.forEach(f => {
                const el = document.getElementById(f.id);
                const err = document.getElementById(f.err);
                if (!el || !err) return;
                if (!f.ok(el.value)) {
                    el.classList.add('error'); err.classList.add('show'); ok = false;
                } else {
                    el.classList.remove('error'); err.classList.remove('show');
                }
                el.oninput = () => { el.classList.remove('error'); err.classList.remove('show'); };
            });
            if (!ok) showToast('⚠ Please fill all required fields');
            return ok;
        }
        // ============================================================
        // FILL REVIEW STEP
        // ============================================================
        function fillReview() {
            const fn = document.getElementById('fName').value.trim();
            const ln = document.getElementById('lName').value.trim();
            const a1 = document.getElementById('addr1').value.trim();
            const a2 = document.getElementById('addr2').value.trim();
            const ct = document.getElementById('city').value.trim();
            const st = document.getElementById('state').value;
            const pi = document.getElementById('pincode').value.trim();
            const ph = document.getElementById('phone').value.trim();

            document.getElementById('rv-name').textContent = `${fn} ${ln}`;
            document.getElementById('rv-addr').textContent = `${a1}, ${a2 ? a2 + ', ' : ''}${ct}, ${st} — ${pi}`;
            document.getElementById('rv-phone').textContent = ph;

            const em = document.getElementById('email').value;
            if (em) document.getElementById('successEmail').textContent = em;

            // Hardcode COD display
            document.getElementById('rv-pay-method').textContent = 'Cash on Delivery';
            document.getElementById('rv-pay-icon').innerHTML = '<i class="fas fa-sack-dollar"></i>';
            document.getElementById('rv-pay-detail').textContent = 'Pay at the time of delivery';

            renderReviewItems();
        }

        // ============================================================
        // PLACE ORDER (Database Connected)
        // ============================================================
        async function placeOrder() {
            if (!document.getElementById('termsChk').checked) {
                showToast('⚠ Please accept the Terms & Conditions');
                return;
            }

            // 1. Force strict Number calculations to prevent MySQL 500 errors
            const subtotal = Number(cart.reduce((s, i) => s + i.price * i.qty, 0)) || 0;
            const origTotal = Number(cart.reduce((s, i) => s + (i.originalPrice || i.price) * i.qty, 0)) || 0;
            const prodDisc = origTotal - subtotal;
            const totalDel = Number(deliveryCharge) + 99; // 99 COD fee
            const afterCoupon = subtotal - (Number(couponSaving) || 0);
            const gst = Math.round(afterCoupon * 0.18);
            const grandTotal = afterCoupon + gst + totalDel;
            const totalDiscount = prodDisc + (Number(couponSaving) || 0);

            // 2. Format Address
            const name = document.getElementById('rv-name').textContent;
            const addr = document.getElementById('rv-addr').textContent;
            const phone = document.getElementById('rv-phone').textContent;
            const fullAddress = `${name}, ${addr}, Phone: ${phone}`;

            const btn = document.querySelector('.btn-place');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing…';
            btn.disabled = true;

            try {
                const response = await fetch('/api/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cart: cart,
                        address: fullAddress,
                        subtotal: origTotal, 
                        discount: totalDiscount,
                        totalAmount: grandTotal,
                        promoCode: couponCode || null
                    })
                });

                const data = await response.json();

                // Check if backend session died (Server restart)
                if (data.expired || response.status === 401) {
                    localStorage.removeItem('luxecasa_user'); // Kill the stale frontend session
                    showToast('⚠ Session expired. Redirecting to login...');
                    setTimeout(() => window.location.href = '/login', 1500);
                    return;
                }

                if (data.success) {
                    localStorage.removeItem('luxecasa_cart');
                    
                    const orderId = '#LC-' + new Date().getFullYear() + '-' + String(Math.floor(Math.random() * 99999)).padStart(5, '0');
                    document.getElementById('successId').textContent = orderId;
                    
                    toStep(4);
                    document.getElementById('successWrap').classList.add('show');
                } else {
                    showToast('⚠ ' + data.message);
                    btn.innerHTML = '<i class="fas fa-bag-shopping"></i> Place Order Securely';
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                showToast('⚠ Server error. Please try again.');
                btn.innerHTML = '<i class="fas fa-bag-shopping"></i> Place Order Securely';
                btn.disabled = false;
            }
        }

        // ============================================================
        // COUPON
        // ============================================================
        // ============================================================
        // COUPON (Database Connected)
        // ============================================================
        async function applyCoupon() {
            const code = document.getElementById('couponInput').value.trim().toUpperCase();
            const fb = document.getElementById('couponFeedback');
            const sub = cart.reduce((s, i) => s + i.price * i.qty, 0);

            if (!code) { showToast('⚠ Enter a coupon code'); return; }

            try {
                const response = await fetch('/api/validate-promo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: code })
                });

                const data = await response.json();

                if (data.success) {
                    const disc = Math.round(sub * (data.discount_percent / 100));
                    couponSaving = disc;
                    couponCode = data.code;

                    fb.className = 'coupon-feedback ok';
                    fb.textContent = `✓ "${data.code}" applied! You save ₹${disc.toLocaleString('en-IN')}`;

                    document.getElementById('pCouponRow').style.display = 'flex';
                    document.getElementById('pCouponCode').textContent = data.code;
                    document.getElementById('pCouponAmt').textContent = `−₹${disc.toLocaleString('en-IN')}`;

                    calcTotal();
                    showToast('🎉 ' + data.message);
                } else {
                    couponSaving = 0;
                    couponCode = '';

                    fb.className = 'coupon-feedback fail';
                    fb.textContent = '✗ ' + data.message;
                    document.getElementById('pCouponRow').style.display = 'none';

                    calcTotal();
                }
            } catch (err) {
                showToast('⚠ Error connecting to server.');
            }
        }

        // ============================================================
        // UI INTERACTION HELPERS
        // ============================================================
        function selectAddr(card) {
            document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');
        }
        function showNewForm() {
            document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
            document.getElementById('newAddrForm').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        function pickDelivery(el, type, charge) {
            document.querySelectorAll('.delivery-opt').forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            deliveryCharge = charge;
            calcTotal();
        }
        function pickPay(el, method) {
            document.querySelectorAll('.pay-tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            document.querySelectorAll('.pay-form').forEach(f => f.classList.remove('show'));
            document.getElementById(`pf-${method}`).classList.add('show');
            payMethod = method;
            calcTotal();
        }
        function pickUpi(el) {
            document.querySelectorAll('.upi-app').forEach(a => a.classList.remove('selected'));
            el.classList.add('selected');
        }
        function pickEmi(el) {
            document.querySelectorAll('.emi-opt').forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
        }
        function fmtCard(inp) {
            let v = inp.value.replace(/\D/g, '').substring(0, 16);
            inp.value = v.replace(/(.{4})/g, '$1  ').trim();
            const ic = document.getElementById('cIcon');
            if (v.startsWith('4')) ic.textContent = '💙';
            else if (v.startsWith('5')) ic.textContent = '🔴';
            else if (v.startsWith('6')) ic.textContent = '🟠';
            else if (v.startsWith('3')) ic.textContent = '🟢';
            else ic.textContent = '💳';
        }
        function fmtExpiry(inp) {
            let v = inp.value.replace(/\D/g, '');
            if (v.length >= 2) v = v.substring(0, 2) + ' / ' + v.substring(2, 4);
            inp.value = v;
        }

        // ============================================================
        // TOAST
        // ============================================================
        let _toast;
        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerHTML = msg; t.classList.add('show');
            clearTimeout(_toast);
            _toast = setTimeout(() => t.classList.remove('show'), 3200);
        }

        // ============================================================
        // NAVBAR SCROLL
        // ============================================================
        window.addEventListener('scroll', () => {
            document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 80);
        });

        // ============================================================
        // INIT
        // ============================================================
        checkSession();
        renderSummary();
    </script>
</body>

</html>