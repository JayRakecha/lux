                <div class="panel-nav">
                    <button class="btn-back" onclick="toStep(1)"><i class="fas fa-arrow-left"></i> Delivery</button>
                    <button class="btn-next" onclick="toStep(3)">Review Order <i
                            class="fas fa-arrow-right"></i></button>
                </div>
            </div><!-- end step-2 -->

            <!-- ========== STEP 3: REVIEW ========== -->
            <div class="checkout-panel checkout-step" id="step-3">
                <div class="panel-header">
                    <div class="panel-icon"><i class="fas fa-magnifying-glass-check"></i></div>
                    <div>
                        <h2>Review Your Order</h2>
                        <p>Check everything before placing your order</p>
                    </div>
                    <div class="panel-badge">Step 3 of 3</div>
                </div>
                <div class="panel-body">

                    <!-- Delivery info -->
                    <div class="section-label">Delivering To</div>
                    <div class="review-info-block" style="margin-bottom:20px;">
                        <div class="rib-icon"><i class="fas fa-location-dot"></i></div>
                        <div>
                            <div class="rib-title" id="rv-name">Rahul Sharma</div>
                            <div class="rib-sub" id="rv-addr">42, Green Park Extension, New Delhi — 110016</div>
                            <div class="rib-sub" id="rv-phone">+91 98765 43210</div>
                        </div>
                        <button class="rib-edit" onclick="toStep(1)"><i class="fas fa-pen"
                                style="margin-right:4px;"></i>Edit</button>
                    </div>

                    <!-- Payment info -->
                    <div class="section-label">Payment Method</div>
                    <div class="review-info-block" style="margin-bottom:24px;">
                        <div class="rib-icon" id="rv-pay-icon"><i class="fas fa-credit-card"></i></div>
                        <div>
                            <div class="rib-title" id="rv-pay-method">Credit / Debit Card</div>
                            <div class="rib-sub" id="rv-pay-detail">•••• •••• •••• ————</div>
                        </div>
                        <button class="rib-edit" onclick="toStep(2)"><i class="fas fa-pen"
                                style="margin-right:4px;"></i>Edit</button>
                    </div>

                    <!-- Items -->
                    <div class="section-label">Items in Order (<span id="rv-count">0</span>)</div>
                    <div id="reviewItems"><!-- JS injects items WITH images --></div>

                    <!-- Terms -->
                    <div class="terms-box">
                        <label>
                            <input type="checkbox" id="termsChk">
                            <span class="terms-text">
                                I agree to LuxeCasa's <a href="#">Terms &amp; Conditions</a> and <a href="#">Privacy
                                    Policy</a>.
                                I confirm that the delivery address and payment details are correct and authorize this
                                transaction.
                            </span>
                        </label>
                    </div>

                </div>
                <div class="panel-nav">
                    <button class="btn-back" onclick="toStep(2)"><i class="fas fa-arrow-left"></i> Payment</button>
                    <button class="btn-place" onclick="placeOrder()">
                        <i class="fas fa-bag-shopping"></i> Place Order Securely
                    </button>
                </div>
            </div><!-- end step-3 -->

            <!-- ========== STEP 4: SUCCESS ========== -->
            <div class="checkout-panel checkout-step" id="step-4">
                <div class="success-wrap" id="successWrap">
                    <div class="success-ring">✓</div>
                    <div class="success-title">Order Placed! 🎉</div>
                    <div class="success-sub">Your luxury furniture is on its way</div>
                    <div class="order-id-box">
                        Order ID
                        <strong id="successId">#LC-2026-00001</strong>
                    </div>
                    <p style="font-size:0.83rem;color:var(--text-muted);">Confirmation sent to <strong
                            id="successEmail">your email</strong></p>
                    <div class="success-track">
                        <div class="track-step"><i class="fas fa-check-circle"></i>
                            <p>Order<br>Confirmed</p>
                        </div>
                        <div class="track-step"><i class="fas fa-box-open"></i>
                            <p>Being<br>Packed</p>
                        </div>
                        <div class="track-step"><i class="fas fa-truck"></i>
                            <p>Dispatched<br>in 24–48 hrs</p>
                        </div>
                    </div>
                    <div class="success-btns">
                        <a href="index.html" class="btn-home"><i class="fas fa-home"></i> Back to Home</a>
                        <a href="products" class="btn-shop"><i class="fas fa-shopping-bag"></i> Shop More</a>
                    </div>
                </div>
            </div><!-- end step-4 -->

        </div><!-- end left col -->

        <!-- ======================================================
         RIGHT COLUMN — ORDER SUMMARY
    ====================================================== -->
        <div class="order-summary">
            <div class="summary-card" id="summaryCard">

                <div class="summary-header">
                    <i class="fas fa-receipt"></i>
                    <h3>Order Summary</h3>
                    <div class="item-count-badge" id="itemCountBadge">0 Items</div>
                </div>

                <!-- Items with images -->
                <div class="summary-items" id="summaryItems">
                    <!-- JS renders items here WITH proper images -->
                </div>

                <!-- Coupon -->
                <div class="coupon-wrap">
                    <div
                        style="font-size:0.72rem;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:9px;">
                        <i class="fas fa-tag" style="color:var(--gold);margin-right:6px;"></i>Apply Coupon
                    </div>
                    <div class="coupon-row-inner">
                        <input type="text" class="coupon-input" id="couponInput" placeholder="Try: LUXE10 · FIRST20">
                        <button class="btn-apply" onclick="applyCoupon()">Apply</button>
                    </div>
                    <div class="coupon-feedback" id="couponFeedback"></div>
                </div>

                <!-- Price breakdown -->
                <div class="price-breakdown">
                    <div class="p-row">
                        <span>Subtotal (<span id="pItemCount">0</span> items)</span>
                        <span id="pSubtotal">₹0</span>
                    </div>
                    <div class="p-row green">
                        <span>Product Discount</span>
                        <span id="pDiscount">−₹0</span>
                    </div>
                    <div class="p-row green" id="pCouponRow" style="display:none;">
                        <span>Coupon (<span id="pCouponCode"></span>)</span>
                        <span id="pCouponAmt">−₹0</span>
                    </div>
                    <div class="p-row green" id="pShippingRow">
                        <span>Delivery</span>
                        <span id="pShipping">FREE</span>
                    </div>
                    <div class="p-row">
                        <span>GST (18%)</span>
                        <span id="pGst">₹0</span>
                    </div>
                    <div class="p-divider"></div>
                    <div class="p-total">
                        <div class="p-total-label">Total Payable</div>
                        <div class="p-total-val" id="pTotal">₹0</div>
                    </div>
                    <div class="savings-banner" id="savingsBanner" style="display:none;">
                        <i class="fas fa-piggy-bank"></i>
                        <p>You're saving <strong id="savingsAmt">₹0</strong> on this order! 🎉</p>
                    </div>
                </div>

                <!-- Trust badges -->
                <div class="trust-grid">
                    <div class="t-badge"><i class="fas fa-shield-halved"></i> Secure Payment</div>
                    <div class="t-badge"><i class="fas fa-rotate-left"></i> 30-Day Returns</div>
                    <div class="t-badge"><i class="fas fa-truck"></i> Free Delivery</div>
                    <div class="t-badge"><i class="fas fa-star"></i> Premium Quality</div>
                    <div class="t-badge"><i class="fas fa-headset"></i> 24/7 Support</div>
                    <div class="t-badge"><i class="fas fa-certificate"></i> Genuine Products</div>
                </div>

            </div><!-- end summary-card -->

            <!-- Need Help -->
            <div class="help-card">
                <div class="help-title">Need Help?</div>
                <a href="tel:+918800000000" class="help-row">
                    <div class="help-icon"><i class="fas fa-phone"></i></div>
                    <div>
                        <div class="help-label">+91 88000 00000</div>
                        <div class="help-sub">Mon–Sat · 9 AM – 7 PM</div>
                    </div>
                </a>
                <a href="contact.html" class="help-row">
                    <div class="help-icon"><i class="fas fa-comment-dots"></i></div>
                    <div>
                        <div class="help-label">Live Chat</div>
                        <div class="help-sub">Replies in ~2 minutes</div>
                    </div>
                </a>
            </div>

        </div><!-- end right col -->

    </div><!-- end checkout-main -->

    <!-- FOOTER -->
