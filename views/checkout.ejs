            container.innerHTML = cart.map(item => {
                const imgUrl = getProductImage(item);
                const emoji = getEmoji(item);
                const lineTotal = (item.price * item.qty).toLocaleString('en-IN');
                const origTotal = item.originalPrice ? (item.originalPrice * item.qty).toLocaleString('en-IN') : null;

                return `
        <div class="s-item">
            <div class="s-img">
                <img
                    src="${imgUrl}"
                    alt="${item.name}"
