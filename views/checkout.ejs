        // ============================================================
        // SESSION CHECK (Require Login)
        // ============================================================
        function checkSession() {
            const user = JSON.parse(localStorage.getItem('luxecasa_user') || 'null');
            if (!user) {
                alert("Please log in to proceed to secure checkout.");
                window.location.href = '/login';
            }
        }
        // Default fallback image (generic furniture)
        const DEFAULT_IMG = 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=200&q=70';

        /**
         * Get the best image URL for a cart item.
         * Priority: item.image → item.img → catalog by ID → catalog by name keyword → default
         */
        function getProductImage(item) {
            // 1. Item already has a valid image URL
            if (item.image && item.image.startsWith('http')) return item.image;
            if (item.img && item.img.startsWith('http')) return item.img;

            // 2. Match by product ID
            const byId = IMG_CATALOG[item.id] || IMG_CATALOG[parseInt(item.id)];
            if (byId) return byId;

            // 3. Match by keyword in product name
            if (item.name) {
                const lowerName = item.name.toLowerCase();
                for (const keyword of Object.keys(IMG_CATALOG)) {
                    if (typeof IMG_CATALOG[keyword] === 'string' && isNaN(keyword)) {
                        if (lowerName.includes(keyword)) return IMG_CATALOG[keyword];
                    }
                }
            }

            // 4. Category fallback
            if (item.category) {
                const c = item.category.toLowerCase();
                for (const keyword of Object.keys(IMG_CATALOG)) {
                    if (isNaN(keyword) && c.includes(keyword)) return IMG_CATALOG[keyword];
                }
            }

            return DEFAULT_IMG;
        }

        // ============================================================
        // EMOJI fallback per category (for broken images)
        // ============================================================
        function getEmoji(item) {
            const n = (item.name || '').toLowerCase();
            if (n.includes('sofa') || n.includes('couch') || n.includes('sectional')) return '🛋';
            if (n.includes('bed') || n.includes('mattress')) return '🛏';
            if (n.includes('chair') || n.includes('armchair') || n.includes('accent')) return '🪑';
            if (n.includes('dining') || n.includes('table')) return '🪵';
            if (n.includes('wardrobe') || n.includes('almirah') || n.includes('cupboard')) return '🚪';
            if (n.includes('lamp') || n.includes('light')) return '💡';
            if (n.includes('mirror')) return '🪞';
            if (n.includes('plant') || n.includes('pot')) return '🪴';
            return '🛋';
        }

        // ============================================================
        // STATE
        // ============================================================
        let cart = JSON.parse(localStorage.getItem('luxecasa_cart') || '[]');
        let deliveryCharge = 0;
        let payMethod = 'cod'; // FORCE COD
        let couponSaving = 0;
        let couponCode = '';
        // ============================================================
        // DEMO CART if localStorage is empty
        // ============================================================
        if (!cart.length) {
            cart = [
                { id: 1, name: 'Tuscany Velvet Sofa', price: 78999, originalPrice: 99999, qty: 1, category: 'sofa' },
                { id: 2, name: 'Milano Oak Dining Table', price: 54999, originalPrice: 69999, qty: 1, category: 'dining' },
                { id: 3, name: 'Vienna Accent Chair', price: 22999, originalPrice: 28999, qty: 2, category: 'chair' },
            ];
        }

        // ============================================================
        // RENDER SUMMARY ITEMS (RIGHT COLUMN) — with images
        // ============================================================
        function renderSummary() {
            const container = document.getElementById('summaryItems');
            const totalQty = cart.reduce((s, i) => s + i.qty, 0);

            document.getElementById('itemCountBadge').textContent = `${totalQty} Item${totalQty !== 1 ? 's' : ''}`;
