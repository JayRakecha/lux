    <!-- ===== JAVASCRIPT ===== -->
    <script>
        // ============================================================
        // READING PROGRESS BAR
        // ============================================================
        const progressBar = document.getElementById('progressBar');
        const progressLabel = document.getElementById('progressLabel');
        let progressShown = false;

        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const pct = Math.round((scrollTop / docHeight) * 100);
            progressBar.style.width = pct + '%';
            progressLabel.textContent = pct + '% READ';
            if (pct > 5) {
                progressLabel.classList.add('visible');
            } else {
                progressLabel.classList.remove('visible');
            }

            const nav = document.getElementById('mainNav');
            const backTop = document.getElementById('backTop');
            if (scrollTop > 80) { nav.classList.add('scrolled'); backTop.classList.add('show'); }
            else { nav.classList.remove('scrolled'); backTop.classList.remove('show'); }
        });

        // ============================================================
        // DARK / LIGHT MODE TOGGLE
        // ============================================================
        const themeToggle = document.getElementById('themeToggle');
        let isDark = false;

        themeToggle.addEventListener('click', () => {
            isDark = !isDark;
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            themeToggle.querySelector('i').className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            showToast(isDark ? '🌙 Dark mode on' : '☀️ Light mode on');
        });

        // ============================================================
        // ACCORDION SECTIONS
        // ============================================================
        function toggleSection(id, btn) {
            const section = document.getElementById(id);
            const isActive = section.classList.contains('active');
            // Close all first
            document.querySelectorAll('.terms-section.active').forEach(s => s.classList.remove('active'));
            // Open clicked if it wasn't active
            if (!isActive) {
                section.classList.add('active');
                // Mark TOC link as active
                document.querySelectorAll('.toc-link').forEach(a => {
                    a.classList.toggle('active', a.dataset.sec === id);
                });
            } else {
                document.querySelectorAll('.toc-link').forEach(a => a.classList.remove('active'));
            }
        }

        // TOC link clicks
        document.querySelectorAll('.toc-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const secId = link.dataset.sec;
                const section = document.getElementById(secId);
                // Open it
                document.querySelectorAll('.terms-section.active').forEach(s => s.classList.remove('active'));
                section.classList.add('active');
                document.querySelectorAll('.toc-link').forEach(a => a.classList.toggle('active', a.dataset.sec === secId));
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        // ============================================================
        // MARK AS READ / UNDERSTOOD
        // ============================================================
        let readCount = 0;
        const TOTAL = 18;

        function markRead(secId, rowEl) {
            if (rowEl.classList.contains('checked')) return;
            rowEl.classList.add('checked');
            readCount++;

            // Update TOC sidebar
            const tocLink = document.querySelector(`.toc-link[data-sec="${secId}"]`);
            if (tocLink) tocLink.classList.add('checked');

            // Update sidebar counter
            document.getElementById('tocProgress').textContent = `${readCount} / ${TOTAL} read`;

            showToast(`✅ Section marked as understood (${readCount}/${TOTAL})`);

            if (readCount === TOTAL) {
                setTimeout(() => {
                    document.getElementById('completionWidget').classList.add('show');
                    document.getElementById('completionWidget').scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 400);
            }
        }

        // ============================================================
        // ANIMATED STAT COUNTERS
        // ============================================================
        function animateCounters() {
            document.querySelectorAll('[data-target]').forEach(el => {
                const target = parseInt(el.dataset.target);
                const suffix = el.dataset.suffix || '';
                const prefix = el.dataset.prefix || '';
                let current = 0;
                const duration = 1200;
                const step = target / (duration / 16);
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    const display = target >= 1000 ? Math.floor(current).toLocaleString('en-IN') : Math.floor(current);
                    el.textContent = prefix + display + suffix;
                }, 16);
            });
        }

        // Trigger counter animation when stats bar is visible
        const statsObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                animateCounters();
                statsObserver.disconnect();
            }
        }, { threshold: 0.3 });
        statsObserver.observe(document.getElementById('statsBar'));

        // ============================================================
        // CART
        // ============================================================
        let cart = JSON.parse(localStorage.getItem('luxecasa_cart') || '[]');

        function updateCartUI() {
            const total = cart.reduce((s, i) => s + i.qty, 0);
            document.getElementById('cartBadge').textContent = total;
            document.getElementById('cartCount').textContent = `(${total} item${total !== 1 ? 's' : ''})`;
            const listEl = document.getElementById('cartItemsList');
            const footerEl = document.getElementById('cartFooter');
            if (cart.length === 0) {
                listEl.innerHTML = `<div style="text-align:center;padding:60px 20px;color:var(--txt-muted)"><i class="fas fa-shopping-bag" style="font-size:3rem;margin-bottom:15px;display:block;opacity:0.2"></i><p>Your cart is empty</p><a href="products" style="color:var(--gold);font-size:0.85rem">Start Shopping →</a></div>`;
                footerEl.style.display = 'none';
            } else {
                listEl.innerHTML = cart.map(item => `<div class="cart-item"><div class="cart-item-img"><img src="${item.img || ''}" alt="${item.name}"></div><div class="cart-item-info"><div class="cart-item-name">${item.name}</div><div class="cart-item-price">₹${item.price.toLocaleString('en-IN')}</div><div class="cart-item-qty"><button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button><span class="qty-num">${item.qty}</span><button class="qty-btn" onclick="changeQty(${item.id},1)">+</button></div><button class="cart-item-remove" onclick="removeFromCart(${item.id})">✕ Remove</button></div></div>`).join('');
                const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
                const gst = Math.round(subtotal * 0.18);
                document.getElementById('cartSubtotal').textContent = `₹${subtotal.toLocaleString('en-IN')}`;
                document.getElementById('cartGST').textContent = `₹${gst.toLocaleString('en-IN')}`;
                document.getElementById('cartTotal').textContent = `₹${(subtotal + gst).toLocaleString('en-IN')}`;
                footerEl.style.display = 'block';
            }
        }
        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) cart = cart.filter(i => i.id !== id);
            localStorage.setItem('luxecasa_cart', JSON.stringify(cart));
            updateCartUI();
        }
        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            localStorage.setItem('luxecasa_cart', JSON.stringify(cart));
            updateCartUI();
            showToast('Item removed from cart');
        }
        function toggleCart() {
            document.getElementById('cartSidebar').classList.toggle('open');
            document.getElementById('cartOverlay').classList.toggle('show');
        }

        // ============================================================
        // UTILITIES
        // ============================================================
        function toggleSearch() {
            const q = prompt('Search for furniture...');
            if (q) window.location.href = `products?search=${encodeURIComponent(q)}`;
        }
        function toggleMobileMenu() {
            const links = document.querySelector('.nav-links');
            links.style.display = links.style.display === 'flex' ? 'none' : 'flex';
        }
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerHTML = msg;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }
        function checkSession() {
            const user = JSON.parse(localStorage.getItem('luxecasa_user') || 'null');
            const btn = document.getElementById('navLoginBtn');
            if (user && btn) { btn.innerHTML = `<i class="fas fa-user-circle"></i> ${user.full_name?.split(' ')[0] || 'Account'}`; btn.href = 'profile.html'; }
        }

        updateCartUI();
        checkSession();

        // Open first section by default
        document.querySelector('.terms-section').classList.add('active');
        document.querySelector('.toc-link').classList.add('active');
    </script>
