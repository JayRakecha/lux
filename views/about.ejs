    <!-- ===== HISTORY TIMELINE ===== -->
    <section class="timeline-section">
        <div class="section-header reveal">
            <span class="section-tag">Our Journey</span>
            <h2 class="section-title">15 Years of <em>Excellence</em></h2>
            <div class="divider-ornament"><i class="fas fa-diamond" style="color:var(--gold)"></i></div>
            <p class="section-desc">From a small workshop with a big dream, to India's finest furniture destination.</p>
        </div>
        <div class="timeline">
            <!-- 2009 -->
            <div class="timeline-item reveal">
                <div class="timeline-content">
                    <span class="tl-year-tag">2009 — The Beginning</span>
                    <h4>LuxeCasa is Founded</h4>
                    <p>Arjun Mehra opens a 500 sq. ft. workshop in Connaught Place, New Delhi, with a team of 12
                        craftsmen and a vision to bring European-quality furniture craftsmanship to India.</p>
                </div>
                <div class="timeline-dot"><span class="dot-year">2009</span></div>
                <div style="width:calc(50% - 40px)"></div>
            </div>
            <!-- 2012 -->
            <div class="timeline-item reveal">
                <div style="width:calc(50% - 40px)"></div>
                <div class="timeline-dot"><span class="dot-year">2012</span></div>
                <div class="timeline-content">
                    <span class="tl-year-tag">2012 — First Flagship Store</span>
                    <h4>Opening of Our First Showroom</h4>
                    <p>We opened our 8,000 sq. ft. flagship showroom in Delhi NCR, welcoming thousands of customers and
                        winning our first industry award — Best New Furniture Brand by India Home Decor Awards.</p>
                </div>
            </div>
            <!-- 2015 -->
            <div class="timeline-item reveal">
                <div class="timeline-content">
                    <span class="tl-year-tag">2015 — Going Digital</span>
                    <h4>Launch of Online Store &amp; Expansion to 5 Cities</h4>
                    <p>LuxeCasa.com goes live and we expand to Mumbai, Bangalore, Chennai and Hyderabad — bringing
                        premium furniture delivery and free in-home assembly to customers across India.</p>
                </div>
                <div class="timeline-dot"><span class="dot-year">2015</span></div>
                <div style="width:calc(50% - 40px)"></div>
            </div>
            <!-- 2018 -->
            <div class="timeline-item reveal">
                <div style="width:calc(50% - 40px)"></div>
                <div class="timeline-dot"><span class="dot-year">2018</span></div>
                <div class="timeline-content">
                    <span class="tl-year-tag">2018 — 5,000 Happy Homes</span>
                    <h4>Milestone: 5,000 Homes Furnished &amp; New Workshop</h4>
                    <p>We celebrated our 5,000th customer with the inauguration of our 20,000 sq. ft. production
                        facility in Rajasthan — home to 300 master craftsmen and state-of-the-art finishing technology.
                    </p>
                </div>
            </div>
            <!-- 2021 -->
            <div class="timeline-item reveal">
                <div class="timeline-content">
                    <span class="tl-year-tag">2021 — Sustainability Pledge</span>
                    <h4>100% Sustainably Sourced Materials</h4>
                    <p>LuxeCasa commits to using only FSC-certified timber and eco-friendly finishes. We plant one tree
                        for every order placed — over 50,000 trees planted to date across Rajasthan and Gujarat.</p>
                </div>
                <div class="timeline-dot"><span class="dot-year">2021</span></div>
                <div style="width:calc(50% - 40px)"></div>
            </div>
            <!-- 2024 -->
            <div class="timeline-item reveal">
                <div style="width:calc(50% - 40px)"></div>
                <div class="timeline-dot"><span class="dot-year">2024</span></div>
                <div class="timeline-content">
                    <span class="tl-year-tag">2024 — Today &amp; Beyond</span>
                    <h4>10,000+ Homes &amp; Pan-India Presence</h4>
                    <p>With 25+ cities served, 500+ craftsmen, 40+ collections and 10,000+ happy homes, LuxeCasa stands
                        as India's most trusted premium furniture brand — and our journey is just beginning.</p>
                </div>
            </div>
        </div>
    </section>

