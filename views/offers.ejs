    <!-- ===== PAGE HERO ===== -->
    <div class="page-hero">
        <div class="page-hero-content">
            <div class="breadcrumb">
                <a href="index.html"><i class="fas fa-home"></i> Home</a>
                <span>/</span>
                <span class="current">Offers & Promotions</span>
            </div>
            <h1>Exclusive <em>Offers</em></h1>
            <p>Discover our latest discounts and premium furniture deals. Copy a code below and apply it at checkout.</p>
        </div>
    </div>

    <div class="offers-page-wrapper">
        <div class="offers-container">

            <section class="coupons-section" id="coupons-section">
                <div class="coupons-grid">

                    <% if (typeof offers !== 'undefined' && offers.length > 0) { %>
                        <% offers.forEach(function(offer) { %>
                            <div class="coupon-card reveal">
                                <div class="coupon-left">
                                    <div class="coupon-icon"><i class="fas fa-ticket-alt"></i></div>
                                    <div class="coupon-info">
                                        <h3><%= offer.title %></h3>
                                        <p>Get <%= offer.discount_percent %>% OFF your entire order.</p>
                                        
                                        <% if (offer.max_uses !== null) { %>
                                            <p style="font-size: 0.8rem; color: var(--gold-dark); margin-top: 8px; font-weight: bold;">
                                                Hurry! Only <%= offer.max_uses - offer.current_uses %> uses left!
                                            </p>
                                        <% } else { %>
                                            <p style="font-size: 0.8rem; color: var(--success); margin-top: 8px;">
                                                Unlimited Uses
                                            </p>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="coupon-right">
                                    <div class="coupon-code" id="code-<%= offer.id %>"><%= offer.discount_code %></div>
                                    <button class="btn-copy" onclick="copyCode('code-<%= offer.id %>', this)">Copy Code</button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="grid-column: 1/-1; text-align: center; padding: 50px 20px;">
                            <i class="fas fa-frown-open" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 15px;"></i>
                            <h3 style="color: var(--dark);">No Active Offers</h3>
                            <p style="color: var(--text-muted);">Check back later or subscribe to our newsletter for exclusive discounts.</p>
                        </div>
                    <% } %>

                </div>
            </section>

<!-- ===== HOW TO REDEEM ===== -->
    <section class="redeem-section">
        <div class="section-header reveal">
            <span class="section-tag">Simple Steps</span>
            <h2 class="section-title">How to <em>Redeem</em> Your Offer</h2>
            <div class="divider-ornament"><i class="fas fa-diamond"></i></div>
            <p class="section-desc">Claiming your discount takes just seconds — follow these four simple steps.</p>
        </div>
        <div class="redeem-steps">
            <div class="redeem-step reveal" style="animation-delay:0.05s">
                <div class="step-num-wrap">
                    <i class="fas fa-search"></i>
                    <span class="step-count">1</span>
                </div>
                <h4>Browse & Select</h4>
                <p>Explore our collections and add your favourite pieces to the cart.</p>
            </div>
            <div class="redeem-step reveal" style="animation-delay:0.1s">
                <div class="step-num-wrap">
                    <i class="fas fa-copy"></i>
                    <span class="step-count">2</span>
                </div>
                <h4>Copy Your Code</h4>
                <p>Click the Copy button on any coupon above — your code is saved instantly.</p>
            </div>
            <div class="redeem-step reveal" style="animation-delay:0.15s">
                <div class="step-num-wrap">
                    <i class="fas fa-tag"></i>
                    <span class="step-count">3</span>
                </div>
                <h4>Apply at Checkout</h4>
                <p>Paste your code in the "Coupon Code" field at checkout and click Apply.</p>
            </div>
            <div class="redeem-step reveal" style="animation-delay:0.2s">
                <div class="step-num-wrap">
                    <i class="fas fa-check-circle"></i>
                    <span class="step-count">4</span>
                </div>
                <h4>Enjoy Your Savings</h4>
                <p>Your discount is applied instantly — review the updated total and place your order!</p>
            </div>
        </div>
    </section>

    </div>
            <section class="newsletter-section" style="margin-top: 60px; padding: 60px 20px; background: var(--dark2); border-radius: 12px; text-align: center;">
                <h2 style="color: var(--white); font-family: 'Playfair Display', serif; font-size: 2.2rem; margin-bottom: 15px;">Subscribe & <span style="color: var(--gold);">Save 10%</span></h2>
                <p style="color: var(--cream2); margin-bottom: 30px;">Join 50,000+ design lovers. Enter your email to get an instant discount code.</p>
                <form id="newsletterForm" class="newsletter-form" onsubmit="subscribeNewsletter(event)" style="display: flex; justify-content: center; max-width: 500px; margin: 0 auto; gap: 10px;">
                    <input type="email" id="newsletterEmail" placeholder="Enter your email address..." required style="flex: 1; padding: 15px 20px; border-radius: 8px; border: none; font-size: 1rem; outline: none;">
                    <button type="submit" style="padding: 15px 30px; background: var(--gold); color: var(--dark); border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s;">Subscribe Now</button>
                </form>
            </section>

    <!-- ===== FOOTER ===== -->
