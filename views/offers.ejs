                <div class="dropdown-menu">
                    <a href="products?cat=sofas" class="dropdown-item"><span class="cat-icon">🛋️</span><span
                            class="cat-name">Sofas</span></a>
                    <a href="products?cat=beds" class="dropdown-item"><span class="cat-icon">🛏️</span><span
