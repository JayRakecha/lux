                    <a href="products?cat=chairs" class="dropdown-item"><span class="cat-icon">🪑</span><span
                            class="cat-name">Chairs</span></a>
                    <a href="products?cat=dining" class="dropdown-item"><span class="cat-icon">🍽️</span><span
                            class="cat-name">Dining</span></a>
                    <a href="products?cat=wardrobes" class="dropdown-item"><span class="cat-icon">🚪</span><span
