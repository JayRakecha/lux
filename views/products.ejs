                </ul>
            </div>

            <!-- Price Range -->
            <div class="sidebar-section">
                <p class="sidebar-title">Price Range</p>
                <div class="price-range-wrap">
                    <input type="range" class="price-slider" id="priceSlider" min="5000" max="500000" value="500000"
                        step="5000" oninput="updatePriceFilter(this.value)">
                    <div class="price-labels">
                        <span>₹5,000</span>
                        <span id="priceLabel">Up to ₹5,00,000</span>
                    </div>
                </div>
            </div>
            <!-- Rating Filter -->
            <div class="sidebar-section">
                <p class="sidebar-title">Min Rating</p>
                <label class="rating-filter"><input type="radio" name="rating" value="0" onchange="applyRatingFilter(0)"
                        checked> All Ratings</label>
                <label class="rating-filter"><input type="radio" name="rating" value="4"
                        onchange="applyRatingFilter(4)"> ⭐⭐⭐⭐ &
                    above</label>
                <label class="rating-filter"><input type="radio" name="rating" value="5"
                        onchange="applyRatingFilter(5)"> ⭐⭐⭐⭐⭐
                    Only</label>
            </div>

            <button class="btn-clear-filter" onclick="clearAllFilters()"><i class="fas fa-undo"
                    style="margin-right:6px"></i>
                Clear All Filters</button>
        </aside>

        <!-- PRODUCTS AREA -->
        <div class="products-area">

            <!-- Mobile filter toggle -->
            <button id="mobileFilterBtn" onclick="toggleMobileFilter()"
                style="display:none;width:100%;padding:12px;background:var(--dark);color:var(--gold);border:none;border-radius:8px;font-size:0.85rem;font-weight:600;cursor:pointer;margin-bottom:15px;"><i
                    class="fas fa-sliders-h" style="margin-right:8px"></i> Filters & Sort</button>

            <!-- Search -->
            <div class="search-bar-wrap">
                <i class="fas fa-search search-icon"></i>
                <input type="text" class="search-bar" id="searchInput" placeholder="Search for sofas, beds, chairs..."
                    oninput="applySearch(this.value)">
                <button class="search-clear" id="searchClear" onclick="clearSearch()"><i
                        class="fas fa-times"></i></button>
            </div>

            <!-- Toolbar -->
            <div class="products-toolbar">
                <div class="toolbar-left">
                    <span class="result-count" id="resultCount"><strong>40</strong> products found</span>
                    <div class="active-filters" id="activeFilters"></div>
                </div>
                <div class="toolbar-right">
                    <select class="sort-select" id="sortSelect" onchange="applySort(this.value)">
                        <option value="default">Sort: Featured</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="rating">Top Rated</option>
                        <option value="newest">Newest First</option>
                        <option value="discount">Best Discount</option>
                    </select>
                    <div class="view-toggle">
                        <button class="view-btn active" onclick="setView(3, this)" title="3 columns"><i
                                class="fas fa-th-large"></i></button>
                        <button class="view-btn" onclick="setView(4, this)" title="4 columns"><i
                                class="fas fa-th"></i></button>
                        <button class="view-btn" onclick="setView('list', this)" title="List view"><i
                                class="fas fa-list"></i></button>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="products-grid" id="productsGrid"></div>

            <!-- Pagination -->
            <div class="pagination-wrap" id="paginationWrap"></div>
        </div>
