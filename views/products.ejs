                            </span></button></li>
                    <li><button class="cat-filter-btn" onclick="filterByCat('coffee-tables', this)"><span>☕ Coffee
                                Tables</span><span class="cat-count">
                                <%= products.filter(p=> p.cat === 'coffee-tables').length %>
                            </span></button></li>
                    <li><button class="cat-filter-btn" onclick="filterByCat('cabinets', this)"><span>🗄️
