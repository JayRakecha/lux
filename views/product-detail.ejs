                    style="margin-right:6px"></i> Add to Cart</button>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i
            class="fas fa-chevron-up"></i></button>

    <!-- ================================================================
     JAVASCRIPT
    ================================================================ -->
    <script>

        const allProducts = JSON.parse('<%- JSON.stringify(product) %>');
        // ============================================================
        // PRODUCT SPEC TABLES (by category)
        // ============================================================
        const catSpecs = {
            sofas: { width: '210 cm', depth: '95 cm', height: '86 cm', seatH: '44 cm', weight: '62 kg', load: '320 kg', frame: 'Solid Teak Hardwood', filling: 'High-density foam + spring', finish: 'Hand-rubbed satin oil', hardware: 'Solid brass', base: 'Tapered solid wood legs', foam: '40D / 35D seat+back' },
            beds: { width: '193 cm (King)', depth: '213 cm', height: '130 cm', seatH: '38 cm', weight: '78 kg', load: '400 kg', frame: 'Solid Sheesham Wood', filling: 'N/A', finish: 'Hand-rubbed teak oil', hardware: 'Antique bronze pulls', base: 'Solid wood slat base (included)', foam: 'N/A' },
            chairs: { width: '78 cm', depth: '83 cm', height: '98 cm', seatH: '46 cm', weight: '18 kg', load: '150 kg', frame: 'Solid hardwood / Steel', filling: 'High-density foam 45D', finish: 'Matte lacquer / Leather wax', hardware: 'Solid brass', base: 'Brushed brass cone legs', foam: '45D seat' },
            dining: { width: '240 cm (8-seater)', depth: '100 cm', height: '76 cm', seatH: '—', weight: '85 kg', load: '500 kg', frame: 'Brushed stainless steel', filling: 'N/A', finish: 'Natural marble seal', hardware: 'Stainless steel', base: 'Pedestal / trestle', foam: 'N/A' },
            wardrobes: { width: '240 cm', depth: '58 cm', height: '210 cm', seatH: '—', weight: '120 kg', load: 'N/A', frame: 'Solid Mango Wood', filling: 'N/A', finish: 'Hand-carved matte', hardware: 'Iron / brass pulls', base: 'Flat panel base', foam: 'N/A' },
            'coffee-tables': { width: '120 cm', depth: '70 cm', height: '40 cm', seatH: '—', weight: '28 kg', load: '80 kg', frame: 'Brushed brass / Steel', filling: 'N/A', finish: 'Polished marble seal', hardware: 'Brushed gold', base: 'Gold metal frame', foam: 'N/A' },
            cabinets: { width: '200 cm', depth: '38 cm', height: '50 cm', seatH: '—', weight: '40 kg', load: '120 kg', frame: 'Engineered MDF', filling: 'N/A', finish: 'Walnut veneer matte', hardware: 'Soft-close hinges', base: 'Floating wall mount', foam: 'N/A' },
        };

        // ============================================================
        // REVIEWS DATA
        // ============================================================
        const reviewsData = [
            { name: 'Priya Sharma', city: 'Mumbai', rating: 5, date: 'March 2025', title: 'Absolutely Stunning!', text: 'I was blown away when this arrived. The quality is even better than the photos suggest. The craftsmanship is exceptional — every detail speaks luxury. My living room looks straight out of a design magazine now!', helpful: 34 },
            { name: 'Rahul Mehta', city: 'Delhi', rating: 5, date: 'February 2025', title: 'Worth Every Rupee', text: 'Initially hesitated at the price, but after receiving it, I have zero regrets. The material is premium, the finish is flawless, and the assembly team was professional and quick. Highly recommend LuxeCasa!', helpful: 28 },
            { name: 'Ananya Iyer', city: 'Bangalore', rating: 4, date: 'January 2025', title: 'Beautiful but Delivery Took Time', text: 'The product itself is gorgeous and exactly as described. Lost one star only because delivery took 10 days instead of the promised 7. But the quality made up for the wait completely.', helpful: 19 },
            { name: 'Vikram Singh', city: 'Pune', rating: 5, date: 'December 2024', title: 'Premium Experience End to End', text: 'From ordering to delivery to assembly — LuxeCasa delivered on every promise. The furniture is solid, luxurious, and makes every guest ask where I bought it. Outstanding brand!', helpful: 41 },
            { name: 'Meera Nair', city: 'Chennai', rating: 5, date: 'November 2024', title: 'My Dream Furniture!', text: 'I had been looking for something like this for years. The texture, the colour, the way it sits in the room — perfection. Customer support was also very responsive when I had a query. 5 stars without hesitation!', helpful: 23 },
        ];

        // ============================================================
        // STATE
        // ============================================================
        let cart = JSON.parse(localStorage.getItem('luxecasa_cart') || '[]');
        let wishlist = JSON.parse(localStorage.getItem('luxecasa_wishlist') || '[]');
        //currentProduct = allProducts;
        // Assign currentProduct from EJS data
        let currentProduct = JSON.parse('<%- JSON.stringify(product) %>');
        let detailQty = 1;

        // ============================================================
        // INIT
        // ============================================================
        function init() {
            // The server (EJS) already rendered the main product and related products!
            // We only need to trigger the global UI elements now.

            if (typeof updateCartUI === 'function') updateCartUI();
            if (typeof checkSession === 'function') checkSession();
            if (typeof initReveal === 'function') initReveal();
            populateSpecs();
        }

        // Run init when the page loads
        document.addEventListener('DOMContentLoaded', init);

        // ============================================================
        // QUANTITY
        // ============================================================
        function changeDetailQty(delta) {
            detailQty = Math.max(1, Math.min(10, detailQty + delta));
            document.getElementById('pdQty').value = detailQty;
        }

        // ============================================================
        // CART
        // ============================================================
        function addToCart(id, name, price, img) {
            const existing = cart.find(i => i.id === id);
            if (existing) existing.qty += detailQty;
            else cart.push({ id, name, price, qty: detailQty, img: img || '' });
            saveCart();
            updateCartUI();
            showToast(`✓ ${name} added to cart!`);
            toggleCart();
        }

        function removeFromCart(id) { cart = cart.filter(i => i.id !== id); saveCart(); updateCartUI(); }
        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) { item.qty += delta; if (item.qty <= 0) removeFromCart(id); else { saveCart(); updateCartUI(); } }
        }
        function saveCart() { localStorage.setItem('luxecasa_cart', JSON.stringify(cart)); }

        function updateCartUI() {
            const total = cart.reduce((s, i) => s + i.qty, 0);
            const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
            const gst = Math.round(subtotal * 0.18);
            const grand = subtotal + gst;
            document.getElementById('cartBadge').textContent = total;
            document.getElementById('cartCount').textContent = `(${total} item${total !== 1 ? 's' : ''})`;
            const listEl = document.getElementById('cartItemsList');
            const footerEl = document.getElementById('cartFooter');
            if (cart.length === 0) {
                listEl.innerHTML = `<div style="text-align:center;padding:60px 20px;color:var(--text-muted)"><i class="fas fa-shopping-bag" style="font-size:3rem;color:var(--cream2);margin-bottom:15px;display:block"></i><p>Your cart is empty</p></div>`;
                footerEl.style.display = 'none';
            } else {
                listEl.innerHTML = cart.map(item => `
        <div class="cart-item">
            <div class="cart-item-img"><img src="${item.img}" alt="${item.name}" onerror="this.src='/image/photo-1555041469-a586c61ea9bc.2.jpeg'"></div>
            <div class="cart-item-info">
                <h4 class="cart-item-name">${item.name}</h4>
                <p class="cart-item-price">₹${item.price.toLocaleString('en-IN')}</p>
                <div class="cart-item-qty">
                    <button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button>
                    <span class="qty-num">${item.qty}</span>
                    <button class="qty-btn" onclick="changeQty(${item.id},1)">+</button>
                </div>
                <button class="cart-item-remove" onclick="removeFromCart(${item.id})">Remove</button>
            </div>
        </div>`).join('');
                document.getElementById('cartSubtotal').textContent = `₹${subtotal.toLocaleString('en-IN')}`;
                document.getElementById('cartGST').textContent = `₹${gst.toLocaleString('en-IN')}`;
                document.getElementById('cartTotal').textContent = `₹${grand.toLocaleString('en-IN')}`;
                footerEl.style.display = 'block';
            }
        }

        function toggleCart() {
            document.getElementById('cartSidebar').classList.toggle('open');
            document.getElementById('cartOverlay').classList.toggle('show');
        }

        // ============================================================
        // WISHLIST
        // ============================================================
        function toggleDetailWishlist() {
            if (!currentProduct) return;
            const id = currentProduct.id;
            const btn = document.getElementById('pdWishlistBtn');
            const idx = wishlist.indexOf(id);
            if (idx === -1) {
                wishlist.push(id);
                btn.classList.add('wishlist-active');
                showToast('❤ Added to wishlist');
            } else {
                wishlist.splice(idx, 1);
                btn.classList.remove('wishlist-active');
                showToast('Removed from wishlist');
            }
            localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
        }

        function toggleWishlist(id, btn) {
            const idx = wishlist.indexOf(id);
            if (idx === -1) { wishlist.push(id); btn.classList.add('wishlist-active'); showToast('❤ Added to wishlist'); }
            else { wishlist.splice(idx, 1); btn.classList.remove('wishlist-active'); showToast('Removed from wishlist'); }
            localStorage.setItem('luxecasa_wishlist', JSON.stringify(wishlist));
        }

        // ============================================================
        // TABS
        // ============================================================
        function switchTab(name, btn) {
            document.querySelectorAll('.pd-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.pd-tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('tab-' + name).classList.add('active');
        }

        // ============================================================
        // PINCODE
        // ============================================================
        function checkPincode() {
            const val = document.getElementById('pincodeInput').value.trim();
            const res = document.getElementById('pincodeResult');
            if (val.length !== 6 || isNaN(val)) { showToast('⚠ Please enter a valid 6-digit pincode'); return; }
            res.style.display = 'flex';
            showToast(`📦 Delivery available to ${val}!`);
        }

        // ============================================================
        // STICKY BAR on scroll
        // ============================================================
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            const bar = document.getElementById('stickyBar');
            const backTop = document.getElementById('backTop');
            if (window.scrollY > 80) { nav.classList.add('scrolled'); backTop.classList.add('show'); }
            else { nav.classList.remove('scrolled'); backTop.classList.remove('show'); }

            // Show sticky bar after scrolling past the CTA buttons
            const ctaRow = document.querySelector('.pd-cta-row');
            if (ctaRow) {
                const rect = ctaRow.getBoundingClientRect();
                if (rect.bottom < 0) bar.classList.add('show');
                else bar.classList.remove('show');
            }
        });

        // ============================================================
        // NAVBAR
        // ============================================================
        function toggleSearch() {
            const q = prompt('Search for furniture...');
            if (q) window.location.href = `products?search=${encodeURIComponent(q)}`;
        }

        function toggleMobileMenu() {
            const links = document.getElementById('navLinks');
            if (links.style.display === 'flex') {
                links.style.display = 'none';
            } else {
                links.style.cssText = 'display:flex;flex-direction:column;position:absolute;top:80px;left:0;right:0;background:#fff;padding:20px;box-shadow:0 20px 40px rgba(0,0,0,0.1);z-index:999;gap:15px;';
            }
        }

        // ============================================================
        // TOAST
        // ============================================================
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerHTML = msg;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // ============================================================
        // REVEAL ANIMATION
        // ============================================================
        function initReveal() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('visible');
                });
            }, { threshold: 0.1 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        }

        // ============================================================
        // SESSION
        // ============================================================
        function checkSession() {
            const user = JSON.parse(localStorage.getItem('luxecasa_user') || 'null');
            const btn = document.getElementById('navLoginBtn');
            if (user && btn) {
                btn.innerHTML = `<i class="fas fa-user-circle"></i> ${user.full_name?.split(' ')[0] || 'Account'}`;
                btn.href = 'profile.html';
            }
        }
        // Fill Specs Table based on product category
        function populateSpecs() {
            if (!currentProduct) return;
            const cat = currentProduct.cat; // e.g., 'sofas'
            const specs = catSpecs[cat];
            if (!specs) return; // just in case

            document.getElementById('specWidth').textContent = specs.width;
            document.getElementById('specDepth').textContent = specs.depth;
            document.getElementById('specHeight').textContent = specs.height;
            document.getElementById('specSeatH').textContent = specs.seatH;
            document.getElementById('specWeight').textContent = specs.weight;
            document.getElementById('specLoad').textContent = specs.load;
            document.getElementById('specFrame').textContent = specs.frame;
            document.getElementById('specFilling').textContent = specs.filling;
            document.getElementById('specFinish').textContent = specs.finish;
            document.getElementById('specHardware').textContent = specs.hardware;
            document.getElementById('specBase').textContent = specs.base;
            document.getElementById('specFoam').textContent = specs.foam;
        }

        // call it after setting currentProduct

        // ============================================================
        // RUN
        // ============================================================
        init();

    </script>
</body>

</html>