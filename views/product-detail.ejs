<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeCasa – Product Detail</title>
    <meta name="description" content="Premium furniture detail – LuxeCasa India's finest furniture store.">
    <link rel="stylesheet" href="css/fonts.css">
    <link rel="stylesheet" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/<%= pageCss %>">
</head>

<body>

    <!-- TOP BAR -->
    <div class="top-bar">
        <span class="top-bar-scroll">
            🚚 <span class="gold">FREE DELIVERY</span> on orders above ₹10,000 &nbsp;|&nbsp;
            ✨ <span class="gold">SUMMER SALE</span> — Up to 40% OFF &nbsp;|&nbsp;
            🛡 <span class="gold">5-YEAR WARRANTY</span> on all furniture &nbsp;|&nbsp;
            📞 Expert home visit available &nbsp;|&nbsp;
        </span>
    </div>

    <!-- NAVBAR -->
    <nav id="mainNav">
        <a class="nav-logo" href="index.html">
            <div class="logo-icon">🏠</div>
            <h1>LUXE<span>CASA</span></h1>
        </a>

        <ul class="nav-links" id="navLinks">
            <li><a href="index.html">Home</a></li>
            <li class="nav-dropdown">
                <a href="products" class="active">Products <i class="fas fa-chevron-down"
                        style="font-size:0.65rem;margin-left:3px"></i></a>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="products?cat=sofas"><span class="cat-icon">🛋</span><span
                            class="cat-name">Sofas</span></a>
                    <a class="dropdown-item" href="products?cat=beds"><span class="cat-icon">🛏</span><span
                            class="cat-name">Beds</span></a>
                    <a class="dropdown-item" href="products?cat=chairs"><span class="cat-icon">🪑</span><span
                            class="cat-name">Chairs</span></a>
                    <a class="dropdown-item" href="products?cat=dining"><span class="cat-icon">🍽</span><span
                            class="cat-name">Dining</span></a>
                    <a class="dropdown-item" href="products?cat=wardrobes"><span class="cat-icon">🚪</span><span
                            class="cat-name">Wardrobes</span></a>
                    <a class="dropdown-item" href="products?cat=coffee-tables"><span class="cat-icon">☕</span><span
                            class="cat-name">Coffee Tables</span></a>
                    <a class="dropdown-item" href="products?cat=cabinets"><span class="cat-icon">🗄</span><span
                            class="cat-name">Cabinets</span></a>
                </div>
            </li>
            <li><a href="offers.html">Offers</a></li>
            <li><a href="about">About</a></li>
            <li><a href="contact.html">Contact</a></li>
            <li><a href="faq.html">FAQ</a></li>
        </ul>

        <div class="nav-actions">
            <button class="nav-icon-btn" onclick="toggleSearch()" title="Search"><i class="fas fa-search"></i></button>
            <a class="nav-icon-btn" href="wishlist.html" title="Wishlist"><i class="fas fa-heart"></i></a>
            <button class="nav-icon-btn" onclick="toggleCart()" title="Cart">
                <i class="fas fa-shopping-bag"></i>
                <span class="cart-badge" id="cartBadge">0</span>
            </button>
            <a href="login.html" class="btn-nav-login" id="navLoginBtn"><i class="fas fa-user"></i> Login</a>
            <div class="hamburger" onclick="toggleMobileMenu()">
                <span></span><span></span><span></span>
            </div>
        </div>
    </nav>


    <!-- BREADCRUMB -->
    <div class="breadcrumb-bar">
        <div class="breadcrumb">
            <a href="index.html"><i class="fas fa-home"></i> Home</a><span>/</span>
            <a href="/products" id="breadcrumbCategory">
                <%= product.cat.replace('-', ' ' ) %>
            </a> <span>/</span>
            <span class="current" id="breadcrumbProduct">
                <%= product.name %>
            </span>
        </div>
    </div>
    <!-- MAIN PRODUCT DETAIL -->
    <div class="pd-section">
        <div class="pd-gallery">
            <div class="pd-main-img-wrap">
                <img id="pdMainImg" src="<%= product.productImage %>" alt="<%= product.name %>">
                <% if (product.badge) { %>
                    <div class="pd-badge-overlay"><span class="badge badge-<%= product.badge %>">
                            <%= product.badge %>
                        </span></div>
                    <% } %>
                        <% if (product.oldPrice && product.oldPrice> product.price) { %>
                            <div class="pd-discount-pill">
                                <%= Math.round((1 - product.price / product.oldPrice) * 100) %>% OFF
                            </div>
                            <% } %>
            </div>
        </div>

        <!-- RIGHT: INFO -->
        <div class="pd-info">
            <p class="pd-category" id="pdCategory">CATEGORY</p>
            <h1 class="pd-name">
                <%= product.name %>
            </h1>

            <!-- Rating -->
            <div class="pd-rating-row">
                <%= '★' .repeat(product.rating) %>
                    <%= '☆' .repeat(5 - product.rating) %>
                        <span class="pd-rating-num">
                            <%= Number(product.rating).toFixed(1) %>
                        </span>
                        <span class="pd-review-count" id="pdReviewCount">(<%= product.reviews %>
                                <%= product.reviews===1 ? 'review' : 'reviews' %>)</span>
                        <span class="pd-verified"><i class="fas fa-check-circle"></i> Verified Brand</span>
            </div>

            <!-- Price -->
            <div class="pd-price-box">
                <span class="pd-price-main">₹<%= product.price.toLocaleString('en-IN') %></span>
                <% if (product.oldPrice && product.oldPrice> product.price) { %>
                    <span class="pd-price-old">₹<%= product.oldPrice.toLocaleString('en-IN') %></span>
                    <span class="pd-price-save">
                        <%= Math.round((1 - product.price / product.oldPrice) * 100) %>% OFF
                    </span>
                    <% } %>
            </div>

            <div class="pd-qty-row">
                <div class="pd-qty-box">
                    <button class="pd-qty-btn" onclick="changeDetailQty(-1)">−</button>
                    <input class="pd-qty-num" type="number" id="pdQty" value="1" min="1" max="5" readonly>
                    <button class="pd-qty-btn" onclick="changeDetailQty(1)">+</button>
                </div>

                <span class="pd-stock">
                    <i class="fas fa-check-circle" style="margin-right:5px"></i>
                    In Stock
                </span>
            </div>

            <div class="pd-cta-row">
                <button class="pd-btn-cart"
                    onclick="addToCart(<%= product.id %>, '<%= product.name %>', <%= product.price %>, '<%= product.productImage %>')"
                    <i class="fas fa-shopping-bag"></i> Add to Cart
                </button>

                <button class="pd-icon-btn" id="pdWishlistBtn" onclick="toggleDetailWishlist()">
                    <i class="fas fa-heart"></i> Wishlist
                </button>
            </div>
            <!-- Size Variants --><!--
            <div class="pd-option-title">Size: <em id="pdSizeLabel">Select</em></div>
            <div class="pd-sizes" id="pdSizes">
                <button class="pd-size-btn active" onclick="selectSize(this)">Standard</button>
                <button class="pd-size-btn" onclick="selectSize(this)">Large +₹8,000</button>
                <button class="pd-size-btn" onclick="selectSize(this)">Extra Large +₹16,000</button>
                <button class="pd-size-btn unavailable" onclick="">Custom (Out of stock)</button>
            </div>-->

            <!-- Quantity --><!--
            <div class="pd-qty-row">
                <div class="pd-qty-box">
                    <button class="pd-qty-btn" onclick="changeDetailQty(-1)">−</button>
                    <input class="pd-qty-num" type="number" id="pdQty" value="1" min="1" max="5" readonly>
                    <button class="pd-qty-btn" onclick="changeDetailQty(1)">+</button>
                </div>
                <span class="pd-stock" id="pdStock"><i class="fas fa-check-circle" style="margin-right:5px"></i> In
                    Stock (12 units left)</span>
            </div>-->

            <!-- CTA Buttons --><!--
            <div class="pd-cta-row">
                <button class="pd-btn-cart" id="addToCartBtn"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                <button class="pd-icon-btn" id="pdWishlistBtn" onclick="toggleDetailWishlist()">
                    <i class="fas fa-heart"></i> Wishlist
                </button>
            </div>-->

            <!-- Icon Row --><!--
            <div class="pd-icon-row"></div>

                <button class="pd-icon-btn" onclick="showToast('📐 Compare feature coming soon!')">
                    <i class="fas fa-sliders-h"></i> Compare
                </button>
                <button class="pd-icon-btn" onclick="showToast('📱 Share link copied!')">
                    <i class="fas fa-share-alt"></i> Share
                </button>-->


            <!-- Trust Badges -->
            <div class="pd-trust-grid">
                <div class="pd-trust-item">
                    <span class="pd-trust-icon"><i class="fas fa-truck"></i></span>
                    <div class="pd-trust-text">
                        <h4>Free Delivery</h4>
                        <p>Above ₹10,000 orders</p>
                    </div>
                </div>
                <div class="pd-trust-item">
                    <span class="pd-trust-icon"><i class="fas fa-shield-alt"></i></span>
                    <div class="pd-trust-text">
                        <h4>5-Year Warranty</h4>
                        <p>Full structural coverage</p>
                    </div>
                </div>
                <div class="pd-trust-item">
                    <span class="pd-trust-icon"><i class="fas fa-undo"></i></span>
                    <div class="pd-trust-text">
                        <h4>30-Day Returns</h4>
                        <p>Hassle-free return policy</p>
                    </div>
                </div>
                <div class="pd-trust-item">
                    <span class="pd-trust-icon"><i class="fas fa-tools"></i></span>
                    <div class="pd-trust-text">
                        <h4>Free Assembly</h4>
                        <p>Professional home installation</p>
                    </div>
                </div>
            </div>

            <!-- Highlights -->
            <div class="pd-highlights">
                <h4>Key Highlights</h4>
                <ul id="pdHighlights">
                    <li><i class="fas fa-gem"></i> Premium handcrafted quality with artisan finishing</li>
                    <li><i class="fas fa-leaf"></i> Sustainably sourced, eco-certified materials</li>
                    <li><i class="fas fa-box"></i> Ready-to-assemble with all tools included</li>
                    <li><i class="fas fa-certificate"></i> ISO certified manufacturing standards</li>
                </ul>
            </div>

            <!-- Share -->
            <div class="pd-share-row">
                <span class="pd-share-label">Share:</span>
                <a href="#" class="pd-share-btn" onclick="showToast('📘 Shared on Facebook!')"><i
                        class="fab fa-facebook-f"></i></a>
                <a href="#" class="pd-share-btn" onclick="showToast('📸 Shared on Instagram!')"><i
                        class="fab fa-instagram"></i></a>
                <a href="#" class="pd-share-btn" onclick="showToast('🐦 Shared on Twitter!')"><i
                        class="fab fa-twitter"></i></a>
                <a href="#" class="pd-share-btn" onclick="showToast('💚 Shared on WhatsApp!')"><i
                        class="fab fa-whatsapp"></i></a>
                <a href="#" class="pd-share-btn" onclick="showToast('📌 Saved to Pinterest!')"><i
                        class="fab fa-pinterest-p"></i></a>
            </div>

        </div>
    </div>

    <!-- TABS SECTION -->
    <div class="pd-tabs-section">
        <div class="pd-tabs-header">
            <button class="pd-tab-btn active" onclick="switchTab('description', this)">Description</button>
            <button class="pd-tab-btn" onclick="switchTab('specs', this)">Specifications</button>
            <button class="pd-tab-btn" onclick="switchTab('delivery', this)">Delivery & Returns</button>
            <button class="pd-tab-btn" onclick="switchTab('reviews', this)">Reviews <span id="reviewCountTab"
                    style="color:var(--gold-dark);font-weight:700"></span></button>
        </div>

        <!-- DESCRIPTION TAB -->
        <div class="pd-tab-panel active" id="tab-description">
            <div class="pd-desc-grid">
                <div class="pd-desc-img">
                    <img id="pdDescImg" src="<%= product.productImage %>" alt="Product Detail">
                </div>
                <div class="pd-desc-text">
                    <h2>Crafted for <em>Living</em><br>Designed to Last</h2>
                    <p id="pdDescLong">Every piece in our collection is meticulously crafted by master artisans using
                        time-honoured techniques. We believe that furniture is not just functional — it is a statement
                        of who you are.</p>
                    <p>The natural grain, the weight of the material, the warmth it brings to a room — these are the
                        details that transform a house into a home. Explore this piece and discover why LuxeCasa is
                        India's most trusted premium furniture brand.</p>
                    <h4
                        style="font-family:'Playfair Display',serif;font-size:0.95rem;color:var(--dark);margin:20px 0 12px;letter-spacing:1px">
                        CARE INSTRUCTIONS</h4>
                    <ul class="pd-care-list">
                        <li><i class="fas fa-spray-can"></i> Wipe with a soft, dry cloth regularly</li>
                        <li><i class="fas fa-tint-slash"></i> Avoid exposure to direct moisture or sunlight</li>
                        <li><i class="fas fa-temperature-low"></i> Keep away from extreme heat sources</li>
                        <li><i class="fas fa-ban"></i> Do not use abrasive cleaners</li>
                        <li><i class="fas fa-shield-alt"></i> Use furniture polish every 3 months for wood</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- SPECS TAB -->
        <div class="pd-tab-panel" id="tab-specs">
            <div class="pd-specs-grid">
                <div class="pd-spec-card reveal">
                    <h4>DIMENSIONS</h4>
                    <table class="pd-spec-table">
                        <tr>
                            <td>Width</td>
                            <td id="specWidth">—</td>
                        </tr>
                        <tr>
                            <td>Depth</td>
                            <td id="specDepth">—</td>
                        </tr>
                        <tr>
                            <td>Height</td>
                            <td id="specHeight">—</td>
                        </tr>
                        <tr>
                            <td>Seat Height</td>
                            <td id="specSeatH">—</td>
                        </tr>
                        <tr>
                            <td>Weight</td>
                            <td id="specWeight">—</td>
                        </tr>
                        <tr>
                            <td>Max Load</td>
                            <td id="specLoad">—</td>
                        </tr>
                    </table>
                </div>
                <div class="pd-spec-card reveal">
                    <h4>MATERIALS & FINISH</h4>
                    <table class="pd-spec-table">
                        <tr>
                            <td>Primary Material</td>
                            <td id="specMaterial">—</td>
                        </tr>
                        <tr>
                            <td>Frame</td>
                            <td id="specFrame">—</td>
                        </tr>
                        <tr>
                            <td>Filling</td>
                            <td id="specFilling">—</td>
                        </tr>
                        <tr>
                            <td>Surface Finish</td>
                            <td id="specFinish">—</td>
                        </tr>
                        <tr>
                            <td>Hardware</td>
                            <td id="specHardware">—</td>
                        </tr>
                        <tr>
                            <td>Legs/Base</td>
                            <td id="specBase">—</td>
                        </tr>
                    </table>
                </div>
                <div class="pd-spec-card reveal">
                    <h4>PRODUCT DETAILS</h4>
                    <table class="pd-spec-table">
                        <tr>
                            <td>Brand</td>
                            <td>LuxeCasa</td>
                        </tr>
                        <tr>
                            <td>SKU</td>
                            <td id="specSKU">—</td>
                        </tr>
                        <tr>
                            <td>Warranty</td>
                            <td>5 Years (Structural)</td>
                        </tr>
                        <tr>
                            <td>Country of Origin</td>
                            <td>India</td>
                        </tr>
                        <tr>
                            <td>Assembly Required</td>
                            <td>Minimal (tools included)</td>
                        </tr>
                        <tr>
                            <td>Packaging</td>
                            <td>Eco-friendly carton box</td>
                        </tr>
                    </table>
                </div>
                <div class="pd-spec-card reveal">
                    <h4>CERTIFICATIONS</h4>
                    <table class="pd-spec-table">
                        <tr>
                            <td>Quality Standard</td>
                            <td>ISO 9001:2015</td>
                        </tr>
                        <tr>
                            <td>Wood Certification</td>
                            <td>FSC Certified</td>
                        </tr>
                        <tr>
                            <td>Finish</td>
                            <td>Non-toxic, Child Safe</td>
                        </tr>
                        <tr>
                            <td>Fire Resistance</td>
                            <td>BS 5852 Compliant</td>
                        </tr>
                        <tr>
                            <td>Environment</td>
                            <td>GREENGUARD Gold</td>
                        </tr>
                        <tr>
                            <td>Foam Density</td>
                            <td id="specFoam">—</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- DELIVERY TAB -->
        <div class="pd-tab-panel" id="tab-delivery">
            <div class="pd-delivery-wrap">
                <div class="pd-delivery-card reveal">
                    <div class="pd-delivery-icon"><i class="fas fa-truck"></i></div>
                    <h4>Free Delivery</h4>
                    <p>Free standard delivery on all orders above ₹10,000. Expected delivery within 5–8 working days
                        across India.</p>
                </div>
                <div class="pd-delivery-card reveal">
                    <div class="pd-delivery-icon"><i class="fas fa-tools"></i></div>
                    <h4>Free Assembly</h4>
                    <p>Our expert team will deliver and assemble your furniture in your home at no extra cost. Just tell
                        us your preferred time slot.</p>
                </div>
                <div class="pd-delivery-card reveal">
                    <div class="pd-delivery-icon"><i class="fas fa-undo-alt"></i></div>
                    <h4>30-Day Returns</h4>
                    <p>Not happy with your purchase? Return within 30 days for a full refund. We'll arrange pickup from
                        your doorstep.</p>
                </div>
            </div>
            <div class="pd-pincode-checker reveal">
                <label><i class="fas fa-map-marker-alt" style="color:var(--gold);margin-right:6px"></i> Check Delivery
                    Date</label>
                <input type="text" class="pd-pincode-input" id="pincodeInput" placeholder="Enter your pincode..."
                    maxlength="6">
                <button class="pd-pincode-btn" onclick="checkPincode()">Check</button>
                <span class="pd-pincode-result" id="pincodeResult"><i class="fas fa-check-circle"></i> Delivered in 5–7
                    days. Free!</span>
            </div>
        </div>

        <!-- REVIEWS TAB -->
        <div class="pd-tab-panel" id="tab-reviews">
            <div class="pd-reviews-summary">
                <div class="pd-reviews-score">
                    <div class="pd-score-big" id="reviewScoreBig">
                        <%= Number(product.rating).toFixed(1) %>
                    </div>
                    <div class="pd-score-stars">
                        <%= '★' .repeat(product.rating) %>
                            <%= '☆' .repeat(5 - product.rating) %>
                    </div>
                    <div class="pd-score-label">Overall Rating</div>
                    <div class="pd-score-total" id="reviewScoreTotal">Based on <%= product.reviews %>
                            <%= product.reviews===1 ? 'review' : 'reviews' %>
                    </div>
                </div>
                <div class="pd-rating-bars">
                    <div class="pd-bar-row">
                        <span class="pd-bar-label">5★</span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:78%"></div>
                        </div>
                        <span class="pd-bar-count">193</span>
                    </div>
                    <div class="pd-bar-row">
                        <span class="pd-bar-label">4★</span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:14%"></div>
                        </div>
                        <span class="pd-bar-count">35</span>
                    </div>
                    <div class="pd-bar-row">
                        <span class="pd-bar-label">3★</span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:5%"></div>
                        </div>
                        <span class="pd-bar-count">12</span>
                    </div>
                    <div class="pd-bar-row">
                        <span class="pd-bar-label">2★</span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:2%"></div>
                        </div>
                        <span class="pd-bar-count">5</span>
                    </div>
                    <div class="pd-bar-row">
                        <span class="pd-bar-label">1★</span>
                        <div class="pd-bar-track">
                            <div class="pd-bar-fill" style="width:1%"></div>
                        </div>
                        <span class="pd-bar-count">2</span>
                    </div>
                </div>
            </div>

            <div class="pd-review-cards" id="reviewCards"></div>

            <div class="pd-review-cards">
                <div class="testimonial-card reveal">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">Ordered the Royal Emperor Bed and the Majestic Sofa together. The
                        quality is
                        absolutely stunning — better than anything I've seen in luxury showrooms at triple the price.
                    </p>
                    <div class="testimonial-author">
                        <div class="author-avatar">RS</div>
                        <div>
                            <p class="author-name">Rahul Sharma</p>
                            <p class="author-title">Interior Designer, Mumbai</p>
                            <p class="author-verified">✓ Verified Purchase</p>
                        </div>
                    </div>
                </div>

                <div class="testimonial-card reveal" style="animation-delay:0.2s">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">The assembly team was professional, punctual and set up everything
                        perfectly. My living room looks like it's straight out of a magazine. LuxeCasa is truly premium.
                    </p>
                    <div class="testimonial-author">
                        <div class="author-avatar">PV</div>
                        <div>
                            <p class="author-name">Priya Verma</p>
                            <p class="author-title">Homemaker, Delhi</p>
                            <p class="author-verified">✓ Verified Purchase</p>
                        </div>
                    </div>
                </div>

                <div class="testimonial-card reveal" style="animation-delay:0.4s">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">Bought the marble dining table for our restaurant. Customers keep asking
                        where we got it. LuxeCasa doesn't just sell furniture — they sell experiences.</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">AK</div>
                        <div>
                            <p class="author-name">Arjun Kapoor</p>
                            <p class="author-title">Restaurant Owner, Bangalore</p>
                            <p class="author-verified">✓ Verified Purchase</p>
                        </div>
                    </div>
                </div>
            </div>
            </section>
        </div>
    </div>

    <section class="related-section">
        <h2 class="section-title" style="text-align:center; margin-bottom:40px;">You May Also <em>Like</em></h2>
        <div class="related-grid">
            <% if (relatedProducts && relatedProducts.length> 0) { %>
                <% relatedProducts.forEach(function(rp, i) { %>
                    <div class="product-card" style="animation-delay:<%= i * 50 %>ms"
                        onclick="window.location.href='/product-detail?id=<%= rp.id %>'">
                        <div class="product-img-wrap">
                            <img src="<%= rp.productImage %>" alt="<%= rp.name %>" loading="lazy">
                            <% if (rp.badge) { %>
                                <div class="product-badges"><span class="badge badge-<%= rp.badge %>">
                                        <%= rp.badge %>
                                    </span></div>
                                <% } %>
                                    <div class="product-actions">
                                        <button class="action-btn"
                                            onclick="event.stopPropagation(); addToCart(<%= rp.id %>, '<%= rp.name %>', <%= rp.price %>)"
                                            title="Add to Cart"><i class="fas fa-bag-shopping"></i></button>
                                    </div>
                        </div>
                        <div class="product-body">
                            <p class="product-cat">
                                <%= rp.cat.replace('-', ' ' ) %>
                            </p>
                            <h3 class="product-name">
                                <%= rp.name %>
                            </h3>
                            <div class="product-meta">
                                <div class="product-rating">
                                    <span style="color:var(--gold)">
                                        <%= '★' .repeat(rp.rating) %>
                                            <%= '☆' .repeat(5 - rp.rating) %>
                                    </span>
                                </div>
                            </div>
                            <div class="product-footer">
                                <div class="product-price">
                                    <span class="price-main">₹<%= rp.price.toLocaleString('en-IN') %></span>
                                    <% if (rp.oldPrice> rp.price) { %>
                                        <span class="price-old">₹<%= rp.oldPrice.toLocaleString('en-IN') %></span>
                                        <% } %>
                                </div>
                                <button class="btn-cart"
                                    onclick="event.stopPropagation(); addToCart(<%= rp.id %>, '<%= rp.name %>', <%= rp.price %>)">
                                    <i class="fas fa-bag-shopping"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <p style="text-align:center; grid-column: 1/-1;">No related products found.</p>
                            <% } %>
        </div>
    </section>
